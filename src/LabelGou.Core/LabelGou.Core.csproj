<Project Sdk="Microsoft.NET.Sdk">

  <!-- LabelGou 核心逻辑层：不依赖 WPF，可被 App / 测试 / 未来 CLI 复用 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LabelGou.Core</RootNamespace>
    <AssemblyName>LabelGou.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 唯一外部依赖（MIT，微软官方）：注册 GB18030/GBK 等中文代码页，
         用于读取打印店常见的 GBK 编码 CSV。XLSX 读取为自建零依赖实现。 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
  </ItemGroup>

</Project>
