<Window x:Class="LabelGou.App.AiPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 提示语 · 可调"
        Width="980" Height="660" MinWidth="820" MinHeight="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei" FontSize="14"
        Background="{DynamicResource PageBgBrush}">
    <!-- 第 103 棒（用户：「对AI识别调优 / 可以自由调整AI提示语开放窗口」）：
         能看、能改、能一键回出厂。开的是"交代分工"那几段固定的话——
         画像、行数、字段清单、他拍过的板那些是软件现算的事实，不在这里，也不该在这里改。 -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SimpleTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="2,0,0,12">
            <TextBlock Text="AI 提示语" Style="{StaticResource ScreenTitle}"/>
            <TextBlock x:Name="WhereText" Style="{StaticResource SubText}" Margin="0,3,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0,0,12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubText}" Margin="4,2,4,8"
                           Text="左边挑一段，右边就是发给 AI 的那段话。改完点「保存这段」立刻生效。"/>
                <ListBox x:Name="SectionList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="OnSectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Mark}" Width="16" Foreground="{DynamicResource BrandBrush}"/>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock x:Name="StateText" DockPanel.Dock="Right" Style="{StaticResource SubText}"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource InkBrush}"/>
                    </DockPanel>
                    <TextBlock x:Name="NoteText" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                </StackPanel>

                <TextBox Grid.Row="1" x:Name="Editor" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Microsoft YaHei" FontSize="13"
                         VerticalContentAlignment="Top" BorderBrush="{DynamicResource LineBrush}"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="保存这段" Style="{StaticResource PrimaryButton}" Click="OnSaveClick"/>
                    <Button Content="恢复默认" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnResetOneClick"
                            ToolTip="把这一段的覆盖文件删掉，下次请求一起用出厂那段"/>
                    <Button Content="全部恢复默认" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnResetAllClick"/>
                    <Button Content="关闭" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnCloseClick"/>
                    <TextBlock x:Name="HintText" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="14,0,0,0"
                               Text="改坏了不怕：任何时候点「全部恢复默认」就回到软件自带的这套。"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
