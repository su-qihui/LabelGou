<Window x:Class="LabelGou.App.SimpleMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:render="clr-namespace:LabelGou.App.Rendering"
        xmlns:mvvm="clr-namespace:LabelGou.App.Mvvm"
        Title="LabelGou 简洁版"
        Width="1320" Height="860"
        MinWidth="1080" MinHeight="700"
        WindowState="Maximized"
        FontFamily="Segoe UI, Microsoft YaHei" FontSize="14"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBgBrush}">
    <!-- 简洁版壳窗（第 91 棒开这一刀，第 94 棒改三栏，第 95 棒补弹入与自适应）：左=这张表 / 中=预览（主导）/ 右=AI + 出纸全屏确认。
         设计真源 = labelgou-word\specs\2026-09-20-新一代界面设计思路.md 与同名概念稿 HTML。
         这里只做「呈现」：数据、命令、闸门全走专业版那份 MainViewModel（同一个实例），
         所以本窗不许出现任何会自己算毫米、自己拼版、自己出纸的路——画法唯一、出口唯一照旧。 -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SimpleTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
            <mvvm:InverseBooleanToVisibilityConverter x:Key="InvBoolVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 细顶栏：这批是谁的货 + 活件流四节点 + 四颗钮（表格 / 打印 / 回专业版） ===== -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SourcePath, FallbackValue=还没打开表}" Style="{StaticResource SubText}" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding RecordInfoText}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                </StackPanel>

                <!-- 活件流：读表 → 拍板 → 排版 → 出纸。档位由 SimpleShellFlow 判（代码里刷颜色），这里只摆形状 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel x:Name="FlowNode0" Orientation="Horizontal">
                        <Ellipse x:Name="FlowDot0" Width="10" Height="10" Fill="{DynamicResource LineBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FlowLabel0" Text="读表" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubInkBrush}"/>
                    </StackPanel>
                    <Border Width="34" Height="2" Background="{DynamicResource LineBrush}" Margin="10,0"/>
                    <StackPanel x:Name="FlowNode1" Orientation="Horizontal">
                        <Ellipse x:Name="FlowDot1" Width="10" Height="10" Fill="{DynamicResource LineBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FlowLabel1" Text="拍板" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubInkBrush}"/>
                    </StackPanel>
                    <Border Width="34" Height="2" Background="{DynamicResource LineBrush}" Margin="10,0"/>
                    <StackPanel x:Name="FlowNode2" Orientation="Horizontal">
                        <Ellipse x:Name="FlowDot2" Width="10" Height="10" Fill="{DynamicResource LineBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FlowLabel2" Text="排版" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubInkBrush}"/>
                    </StackPanel>
                    <Border Width="34" Height="2" Background="{DynamicResource LineBrush}" Margin="10,0"/>
                    <StackPanel x:Name="FlowNode3" Orientation="Horizontal">
                        <Ellipse x:Name="FlowDot3" Width="10" Height="10" Fill="{DynamicResource LineBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FlowLabel3" Text="出纸" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubInkBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="打开数据文件…" Style="{StaticResource GhostButton}" Command="{Binding OpenFileCommand}" Margin="0,0,8,0"/>
                    <Button x:Name="TableToggleBtn" Content="表格" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            ToolTip="开关左栏：这张表读进来的原样（收起来时中间预览自己补位）"/>
                    <Button x:Name="AiToggleBtn" Content="AI" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            ToolTip="开关右栏：AI 指令岛（同一块面板，收起来不丢会话）"/>
                    <Button x:Name="HomeBtn" Content="首页" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            ToolTip="回首页：拖文件进来 + 模板海报墙（还没导数据时它本来就在中间）"/>
                    <Button x:Name="PrintAskBtn" Content="打印整版" Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="BackToProBtn" Content="回专业版" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            ToolTip="回到一代全功能界面：同一份数据、同一个 AI 会话搬回去，两边随时可切"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 三栏工作台（第 94 棒，用户指着 Qoder 界面说的）：左=这张表 / 中=预览（主导）/ 右=AI。
                 左右两根栏随时开关，收起来占 0 宽、中间那格自己补位；两根竖柄拖宽。
                 第 95 棒：两侧列宽改成 Auto——真正的宽度长在 Reveal 那层 Border 上，动画只动它一个数。 ===== -->
        <Grid Grid.Row="1" x:Name="Stage" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 弹入容器：ClipToBounds 裁边，Width 从 0 走到目标（PaneRevealWidth），栏就从屏幕外推进来；
                 里面那层钉死目标宽 + 贴边对齐，所以动画期间内容不重排，只是被一点点露出来 -->
            <Border x:Name="LeftPaneReveal" Grid.Column="0" Width="0" ClipToBounds="True">
            <Border x:Name="LeftPane" Style="{StaticResource FloatCard}" Width="560" Margin="0,0,6,0" HorizontalAlignment="Left">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,12,12,8">
                        <StackPanel>
                            <TextBlock Text="这张表（软件读进来的原样）" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="行号＝Excel 行号；要改数据回表里改，这里只是镜子" Style="{StaticResource SubText}"/>
                        </StackPanel>
                        <Button x:Name="TableCloseBtn" Content="收起 «" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                ToolTip="关掉左栏（顶栏那颗「表格」也能开关同一根）"/>
                    </Grid>
                    <Border Grid.Row="1" Margin="14,0,14,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8">
                        <DataGrid ItemsSource="{Binding PreviewTable}"
                                  AutoGenerateColumns="True"
                                  AutoGeneratingColumn="TableGrid_AutoGeneratingColumn"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="All" SelectionUnit="Cell"
                                  FontSize="12.5" RowHeaderWidth="0" BorderThickness="0"/>
                    </Border>
                    <TextBlock Grid.Row="2" Margin="14,0,14,12" Style="{StaticResource SubText}"
                               Text="合计行/被剔行按 ① 步的口径来；这里看到的就是引擎拿到的。"/>
                </Grid>
            </Border>
            </Border>
            <!-- 左栏与中间之间那根竖柄：18 DIP 跨着边线（第 93 棒教训：贴着边的 9 DIP 隐形柄等于没有） -->
            <Thumb x:Name="LeftSplitThumb" Grid.Column="1" Width="18" Cursor="SizeWE" HorizontalAlignment="Left"
                   Background="Transparent" BorderThickness="0"
                   ToolTip="按住左右拖：改左栏宽度（中间跟着让位）">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" Width="18">
                            <Rectangle Width="4" Height="48" RadiusX="2" RadiusY="2" Fill="{DynamicResource SubInkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- 中间：预览是主角 -->
            <Border Grid.Column="2" x:Name="CanvasCard" Style="{StaticResource Card}" Background="{DynamicResource PageBgBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 预览可用地那一格（第 95 棒：纸要「自动显示全」就得知道这一格多大）。
                         尺寸一变就走专业版同一条 FitTo（MainViewModel.cs:1615，留 24 像素边），不开第二套自适应。 -->
                    <Grid Grid.Row="0" x:Name="PreviewHost" SizeChanged="OnPreviewHostSizeChanged">
                        <!-- 没数据时的引导（不是空白一块让人以为程序坏了） -->
                        <TextBlock Text="把工厂发来的 Excel / CSV 点「打开数据文件…」选进来&#10;AI 模式会先读表，只问要你拍板的事"
                                   Visibility="{Binding HasData, Converter={StaticResource InvBoolVis}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   FontSize="16" Foreground="{DynamicResource SubInkBrush}"/>

                        <!-- 预览包进白卡（概念稿 .paper 的形状：白纸浮在桌面上，带边带影）。
                             LabelPreviewControl 自己按真实毫米画纸，这里只给它一个"浮起来"的托，不碰画法 -->
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1" CornerRadius="4" Effect="{StaticResource Shadow2}"
                                Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasLayout, Converter={StaticResource BoolVis}}">
                            <render:LabelPreviewControl x:Name="LabelView"
                                                        Layout="{Binding CurrentLayout}"
                                                        Zoom="{Binding Zoom}"
                                                        ShowGuides="{Binding ShowGuides}"/>
                        </Border>
                    </Grid>

                    <!-- 画布脚：翻页与缩放（都是现成命令，不新开路） -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Button Content="⏮" Style="{StaticResource GhostButton}" MinWidth="36" Command="{Binding FirstRecordCommand}"/>
                        <Button Content="◀" Style="{StaticResource GhostButton}" MinWidth="36" Margin="6,0,0,0" Command="{Binding PrevRecordCommand}"/>
                        <TextBlock Text="{Binding RecordInfoText}" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                        <Button Content="▶" Style="{StaticResource GhostButton}" MinWidth="36" Command="{Binding NextRecordCommand}"/>
                        <Button Content="⏭" Style="{StaticResource GhostButton}" MinWidth="36" Margin="6,0,0,0" Command="{Binding LastRecordCommand}"/>
                        <Button Content="示意预览" Style="{StaticResource GhostButton}" Margin="14,0,0,0" Command="{Binding SamplePreviewCommand}"/>
                        <Button Content="－" Style="{StaticResource GhostButton}" MinWidth="36" Margin="14,0,0,0" Command="{Binding ZoomOutCommand}"
                                  Click="OnManualZoomClick" ToolTip="手动缩小（自动显示全就此让位，点「适应」按回去）"/>
                        <Button Content="＋" Style="{StaticResource GhostButton}" MinWidth="36" Margin="6,0,0,0" Command="{Binding ZoomInCommand}"
                                  Click="OnManualZoomClick" ToolTip="手动放大（自动显示全就此让位，点「适应」按回去）"/>
                        <Button x:Name="FitBtn" Content="适应" Style="{StaticResource GhostButton}" MinWidth="44" Margin="14,0,0,0"
                                Click="OnFitClick" ToolTip="让这张纸完整落在框里（默认就开着；拖栏、换模板都跟着自动重算）"/>
                    </StackPanel>

                    <!-- ===== 首页（第 97 棒 A 案）：没导数据时中间这一屏就是它；导了数据靠顶栏「首页」请回来。
                             概念稿屏① 四块里做了三块——拖入区 + 海报墙 + 画布当主角；「最近这批」任务卡这版不做
                             （软件还没存过"这批打过什么"那份账，那是另一摊决定）。 ===== -->
                    <ScrollViewer Grid.Row="0" Grid.RowSpan="2" x:Name="HomePanel" Padding="26,18"
                                  Background="{DynamicResource PageBgBrush}"
                                  VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                                  AllowDrop="True" Drop="OnHomeDrop" DragOver="OnHomeDragOver" DragLeave="OnHomeDragLeave">
                        <StackPanel MaxWidth="1080">
                            <Border x:Name="DropZone" CornerRadius="14" BorderThickness="2" Cursor="Hand"
                                    BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource CardBrush}"
                                    Padding="26,26" MouseLeftButtonUp="OnDropZoneClick">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⇪" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource BrandBrush}"/>
                                    <TextBlock Text="把工厂发来的表拖进来" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Style="{StaticResource SubText}" TextAlignment="Center" Margin="0,6,0,0"
                                               Text="Excel / CSV 都行 · 点这一块也可以选文件 · AI 会自动读表，只问你该拍板的事"/>
                                </StackPanel>
                            </Border>

                            <DockPanel Margin="2,22,2,8">
                                <TextBlock Text="模板海报墙" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                <TextBlock Style="{StaticResource SubText}" TextAlignment="Right" Margin="12,0,0,0"
                                           Text="每张卡就是这份模板排出来的真预览（与出纸同一画法）· 点一下即换上"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding PosterCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="248" Margin="0,0,12,12" Padding="10" CornerRadius="12" Cursor="Hand"
                                                Background="{DynamicResource CardBrush}" Tag="{Binding}"
                                                MouseLeftButtonUp="OnPosterCardClick">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <!-- 纸在深浅两色下都保持白：纸就是纸，界面黑不代表打印出来黑 -->
                                                <Border Height="132" Background="White" CornerRadius="6" ClipToBounds="True">
                                                    <Viewbox Stretch="Uniform" Margin="4">
                                                        <render:LabelPreviewControl Layout="{Binding Layout}" Zoom="1" ShowGuides="False"/>
                                                    </Viewbox>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Margin="2,8,2,0" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding BadgeText}" Margin="2,1,2,0" FontSize="11"
                                                           Foreground="{DynamicResource SubInkBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== 右栏：AI 指令岛（第 94 棒：从浮在右下角那张卡改成顶到底一根栏） ===== -->
            <Thumb x:Name="RightSplitThumb" Grid.Column="3" Width="18" Cursor="SizeWE" HorizontalAlignment="Right"
                   Background="Transparent" BorderThickness="0"
                   ToolTip="按住左右拖：改右栏 AI 的宽度（中间跟着让位）">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" Width="18">
                            <Rectangle Width="4" Height="48" RadiusX="2" RadiusY="2" Fill="{DynamicResource SubInkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Border x:Name="RightPaneReveal" Grid.Column="4" Width="0" ClipToBounds="True">
            <Border x:Name="RightPane" Style="{StaticResource FloatCard}" Width="440" Margin="6,0,0,0" Padding="12,10"
                    HorizontalAlignment="Right">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,0,0,6">
                        <TextBlock Text="AI 指令岛" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrandBrush}"/>
                        <Button x:Name="AiCloseBtn" Content="收起 »" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                ToolTip="关掉右栏（顶栏那颗「AI」也能开关同一根）"/>
                    </Grid>
                    <!-- 内容 = MainWindow 的 AiChatPanel 本体（SimpleShellFlow.Park 搬进来）；壳窗只当宿主，不建第二份面板 -->
                    <ContentControl x:Name="Island" Grid.Row="1" MinHeight="320"/>
                </Grid>
            </Border>
            </Border>
        </Grid>

        <!-- ===== 底部状态条：一句话，取 VM 的 StatusMessage（谁最后写谁，口径同 §五-129） ===== -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SubText}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- ===== 出纸全屏确认：整张纸放大 + 一颗大按钮（第 75 棒 ConfirmGate 的可视化，不开第二条出纸路） ===== -->
        <Grid Grid.RowSpan="3" x:Name="PrintOverlay" Background="#F010151C" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="White" Padding="10" CornerRadius="4">
                    <render:SheetPreviewControl x:Name="ShellSheetView"
                                                Plan="{Binding Sheet.Plan}"
                                                PageIndex="{Binding Sheet.PageIndex}"
                                                Zoom="{Binding Sheet.SheetZoom}"
                                                ShowGuides="False" ShowLabelDividers="False"
                                                MaxHeight="520"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="⏮ ◀" Style="{StaticResource GhostButton}" Command="{Binding Sheet.FirstPageCommand}"/>
                    <TextBlock Text="{Binding Sheet.PageText}" Foreground="#C7D0DB" VerticalAlignment="Center" Margin="12,0" FontWeight="Bold"/>
                    <Button Content="▶ ⏭" Style="{StaticResource GhostButton}" Command="{Binding Sheet.NextPageCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Sheet.PlanText}" Foreground="#9AA6B5" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource FloatCard}" HorizontalAlignment="Center" Margin="0,0,0,26" Padding="16,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" MinWidth="190">
                        <TextBlock Text="{Binding Export.SelectionText}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Export.FitText}" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Export.Printers}" SelectedItem="{Binding Export.SelectedPrinter}"
                              DisplayMemberPath="DisplayName" MinWidth="200" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding Export.Copies, UpdateSourceTrigger=PropertyChanged}" Width="52" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="打印整版" Style="{StaticResource PrimaryButton}" Command="{Binding Export.PrintCommand}" FontSize="15" Padding="22,10"/>
                    <Button Content="导出 PDF" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding Export.ExportPdfCommand}"/>
                    <Button x:Name="PrintBackBtn" Content="← 回去改" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
