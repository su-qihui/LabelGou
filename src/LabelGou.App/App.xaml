<Application x:Class="LabelGou.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 第 93 棒：StartupUri 摘了。开哪一版界面要按 UiState.LastShell 决定（默认简洁版），
         而 StartupUri 只会写死开主窗——改由 OnStartup 亲手开窗（setter 不接受 null 那条老坑的正规解法就是压根不设它）。 -->
    <Application.Resources>

        <!-- 全局样式：打印店操作员用的就是"看得清、点得动"的控件，不做花活 -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8,6,8,8" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="3,0" />
        </Style>

        <Style TargetType="TextBlock" x:Key="StepTitle">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#1A3A5C" />
        </Style>

        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="11" />
        </Style>

    </Application.Resources>
</Application>
