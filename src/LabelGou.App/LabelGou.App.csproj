<Project Sdk="Microsoft.NET.Sdk">

  <!-- LabelGou WPF 前端（M1：导入 → 映射 → 模板 → 单标签预览） -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Win7 变体：net8.0 → net6.0。M6 为了用 Windows 内置 OCR（Windows.Media.Ocr）保留了 10.0.19041 后缀；
         本变体 W2 删掉 OCR 后会进一步降到 net6.0-windows（去掉 WinRT 投影）。
         投影程序集 Microsoft.Windows.SDK.NET.dll 是 app-local 拷贝，目标机器不需要装任何东西；
         它只出现在 App 层，Core 保持纯逻辑身份。 -->
    <TargetFramework>net6.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LabelGou.App</RootNamespace>
    <AssemblyName>LabelGou</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>LabelGou.App.App</StartupObject>
    <!-- 品牌图标（第 9 棒第 37 项）：exe 文件图标与标题栏/任务栏默认图标都从这里来，
         .ico 由 _probe\make-ico\make_ico.py 从 assets\labelgou-mark-1024.png 打包（16~128 走 BMP、256 走 PNG）。 -->
    <ApplicationIcon>..\..\assets\labelgou.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabelGou.Core\LabelGou.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 画布那一层的按下分派点（TemplateEditorControl.TryToolDown）留成 internal：它不是产品 API，
         但"勾了工具开关却什么都没发生"这类毛病只有这一层能钉住，所以让测试工程读得到。 -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>LabelGou.App.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
