<Project Sdk="Microsoft.NET.Sdk">

  <!-- LabelGou WPF 前端（M1：导入 → 映射 → 模板 → 单标签预览） -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LabelGou.App</RootNamespace>
    <AssemblyName>LabelGou</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>LabelGou.App.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabelGou.Core\LabelGou.Core.csproj" />
  </ItemGroup>

</Project>
