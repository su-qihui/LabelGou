<Window x:Class="LabelGou.App.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:render="clr-namespace:LabelGou.App.Rendering"
        xmlns:tm="clr-namespace:LabelGou.Core.Templates;assembly=LabelGou.Core"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{Binding Title}"
        Width="1180" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        FontFamily="Microsoft YaHei"
        Background="#F4F5F7">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="BoolVisInv"
                                                   xmlns:local="clr-namespace:LabelGou.App.Mvvm" />
        <!--
            StepTitle / Hint 在本窗口再定一份：App.xaml 的资源只有 Application.Current 存在时才能解析，
            而独立窗口必须能在没有 Application 的环境里被加载（单测就是这么加载它的）。
        -->
        <Style TargetType="TextBlock" x:Key="StepTitle">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#1A3A5C" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="56" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 工具条：按"加元素 → 摆位置 → 存起来"的操作顺序排，不按功能分类排 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,8">
            <WrapPanel>
                <TextBlock Text="模板名：" Style="{StaticResource Caption}" />
                <TextBox Width="170" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                <Separator Width="14" Background="Transparent" />

                <TextBlock Text="加元素：" Style="{StaticResource Caption}" />
                <Button Content="文本" Command="{Binding AddTextCommand}" ToolTip="加一个文本元素（可含字段占位符）" />
                <Button Content="线条" Command="{Binding AddLineCommand}" ToolTip="加分隔线" />
                <Button Content="矩形框" Command="{Binding AddRectCommand}" ToolTip="加边框/表格线" />
                <Button Content="图片" Command="{Binding AddImageCommand}" ToolTip="加 Logo 或条码图，会复制到模板目录" />
                <Button Content="复制" Command="{Binding DuplicateCommand}" ToolTip="复制选中元素（偏移 2mm）" />
                <Button Content="删除" Command="{Binding RemoveCommand}" ToolTip="删除选中元素，可撤销" />
                <Separator Width="14" Background="Transparent" />

                <TextBlock Text="对齐标签：" Style="{StaticResource Caption}" />
                <Button Content="贴左" Command="{Binding AlignCommand}" CommandParameter="Left" />
                <Button Content="横中" Command="{Binding AlignCommand}" CommandParameter="Center" />
                <Button Content="贴右" Command="{Binding AlignCommand}" CommandParameter="Right" />
                <Button Content="贴顶" Command="{Binding AlignCommand}" CommandParameter="Top" />
                <Button Content="纵中" Command="{Binding AlignCommand}" CommandParameter="Middle" />
                <Button Content="贴底" Command="{Binding AlignCommand}" CommandParameter="Bottom" />
                <Separator Width="14" Background="Transparent" />

                <TextBlock Text="内边距：" Style="{StaticResource Caption}" />
                <Button Content="左" Command="{Binding PaddingCommand}" CommandParameter="Left" ToolTip="贴到内边距线（黄虚线）" />
                <Button Content="中" Command="{Binding PaddingCommand}" CommandParameter="Center" />
                <Button Content="右" Command="{Binding PaddingCommand}" CommandParameter="Right" />
                <Button Content="底" Command="{Binding PaddingCommand}" CommandParameter="Bottom" />
                <Separator Width="14" Background="Transparent" />

                <Button Content="置最上" Command="{Binding BringToFrontCommand}" ToolTip="压在别的元素上面" />
                <Button Content="置最下" Command="{Binding SendToBackCommand}" ToolTip="垫到别的元素下面" />
                <Button Content="撤销" Command="{Binding UndoCommand}" ToolTip="Ctrl+Z" />
                <Button Content="重做" Command="{Binding RedoCommand}" ToolTip="Ctrl+Y" />
                <Separator Width="14" Background="Transparent" />

                <CheckBox Content="网格" IsChecked="{Binding ShowGrid}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <CheckBox Content="吸附" IsChecked="{Binding SnapEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"
                          ToolTip="拖动时自动贴到边、中心线和别的元素上" />
                <CheckBox Content="贴网格" IsChecked="{Binding SnapToGrid}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="步长" Style="{StaticResource Caption}" />
                <ComboBox Width="64" SelectedItem="{Binding GridStepMm}" VerticalAlignment="Center">
                    <sys:Double>0.5</sys:Double>
                    <sys:Double>1</sys:Double>
                    <sys:Double>2</sys:Double>
                    <sys:Double>5</sys:Double>
                </ComboBox>
                <CheckBox Content="显示样例文字" IsChecked="{Binding ShowPreviewText}" VerticalAlignment="Center" Margin="8,0,8,0"
                          ToolTip="关掉就只看框，摆位置更快" />
                <Separator Width="14" Background="Transparent" />

                <Button Content="保存" FontWeight="Bold" Command="{Binding SaveCommand}" MinWidth="80" />
                <Button Content="另存为副本" Command="{Binding SaveAsCopyCommand}" />
                <Button Content="放弃改动" Command="{Binding RevertCommand}" />
            </WrapPanel>
        </Border>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="#333333" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Foreground="#C62828" ToolTip="有错误时保存会被拒绝">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="校验通过，可以保存" />
                            <Setter Property="Foreground" Value="#2E7D32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Text" Value="有错误没解决，保存会被拒绝（看右侧清单）" />
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- 左：元素列表 + 插入字段 -->
            <GroupBox Grid.Column="0" Margin="0,0,10,0">
                <GroupBox.Header>
                    <TextBlock Text="元素（末尾=最上层）" Style="{StaticResource StepTitle}" />
                </GroupBox.Header>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="插入字段到标签：" Style="{StaticResource Hint}" />
                        <ComboBox ItemsSource="{Binding FieldOptions}"
                                  SelectedItem="{Binding SelectedFieldOption}"
                                  DisplayMemberPath="Display" MaxDropDownHeight="320" Margin="0,4,0,0" />
                        <Button Content="插入选中字段" Command="{Binding InsertFieldCommand}"
                                CommandParameter="{Binding SelectedFieldOption.Token}" Margin="0,6,0,0" MinWidth="110" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Elements}" SelectedItem="{Binding SelectedRow}"
                             HorizontalContentAlignment="Stretch" FontFamily="Consolas, Microsoft YaHei">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding GeometryText}" FontSize="10" Foreground="#888888" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <!-- 中：画布 -->
            <Border Grid.Column="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <render:TemplateEditorControl x:Name="Canvas" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="8,4,8,6"
                               Text="拖动摆位置；抓住边角小方块改大小；方向键微调（细调 Shift+方向键 = 0.1mm，粗调 Ctrl+方向键 = 2mm）；滚轮缩放，双击空白复位。" />
                </Grid>
            </Border>

            <!-- 右：属性 + 校验 -->
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="标签尺寸" Style="{StaticResource StepTitle}" />
                    </GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="宽(mm)" Style="{StaticResource Caption}" />
                        <TextBox Grid.Column="1" Text="{Binding WidthMm, StringFormat={}{0:0.##}}" Margin="0,0,6,4" />
                        <TextBlock Grid.Column="2" Text="高(mm)" Style="{StaticResource Caption}" />
                        <TextBox Grid.Column="3" Text="{Binding HeightMm, StringFormat={}{0:0.##}}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Text="内边距" Style="{StaticResource Caption}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PaddingMm, StringFormat={}{0:0.##}}" Margin="0,0,6,4" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="外框线" Style="{StaticResource Caption}" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding BorderMm, StringFormat={}{0:0.##}}" Margin="0,0,0,4"
                                 ToolTip="0 表示不画外框" />
                        <TextBlock Grid.Row="2" Text="备注" Style="{StaticResource Caption}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Note}" />
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1">
                    <GroupBox.Header>
                        <TextBlock Text="选中元素" Style="{StaticResource StepTitle}" />
                    </GroupBox.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="点画布上的元素或左边列表选一个，就能改它的属性。"
                                       Style="{StaticResource Hint}"
                                       Visibility="{Binding HasSelection, Converter={StaticResource BoolVisInv}}" />
                            <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="类型" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Editing.KindText}" FontWeight="Bold" Margin="0,3,0,3" />

                                <TextBlock Grid.Row="1" Text="内容" Style="{StaticResource Caption}" Visibility="{Binding Editing.IsText, Converter={StaticResource BoolVis}}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Editing.Text}"
                                         AcceptsReturn="True" MinHeight="46" TextWrapping="Wrap"
                                         ToolTip="写 {{字段名}} 就是变量，例如 {{Consignee}}；纯文字也照印"
                                         Visibility="{Binding Editing.IsText, Converter={StaticResource BoolVis}}" />

                                <TextBlock Grid.Row="2" Text="图片" Style="{StaticResource Caption}" Visibility="{Binding Editing.IsImage, Converter={StaticResource BoolVis}}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Editing.ImagePath}"
                                         ToolTip="相对模板目录，或写绝对路径"
                                         Visibility="{Binding Editing.IsImage, Converter={StaticResource BoolVis}}" />

                                <TextBlock Grid.Row="3" Text="X(mm)" Style="{StaticResource Caption}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Editing.X, StringFormat={}{0:0.##}}" />
                                <TextBlock Grid.Row="4" Text="Y(mm)" Style="{StaticResource Caption}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Editing.Y, StringFormat={}{0:0.##}}" />

                                <TextBlock Grid.Row="5" Text="宽(mm)" Style="{StaticResource Caption}" Visibility="{Binding Editing.HasBox, Converter={StaticResource BoolVis}}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Editing.Width, StringFormat={}{0:0.##}}"
                                         Visibility="{Binding Editing.HasBox, Converter={StaticResource BoolVis}}" />
                                <TextBlock Grid.Row="6" Text="高(mm)" Style="{StaticResource Caption}" Visibility="{Binding Editing.HasBox, Converter={StaticResource BoolVis}}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Editing.Height, StringFormat={}{0:0.##}}"
                                         Visibility="{Binding Editing.HasBox, Converter={StaticResource BoolVis}}" />

                                <TextBlock Grid.Row="7" Text="线宽(mm)" Style="{StaticResource Caption}" />
                                <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Editing.ThicknessMm, StringFormat={}{0:0.###}}"
                                         ToolTip="印刷常用 0.25~0.5" />

                                <TextBlock Grid.Row="8" Text="字号(pt)" Style="{StaticResource Caption}" Visibility="{Binding Editing.IsText, Converter={StaticResource BoolVis}}" />
                                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4"
                                            Visibility="{Binding Editing.IsText, Converter={StaticResource BoolVis}}">
                                    <TextBox Width="52" Text="{Binding Editing.FontSizePt, StringFormat={}{0:0.#}}" />
                                    <CheckBox Content="加粗" IsChecked="{Binding Editing.Bold}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <CheckBox Content="自动缩字" IsChecked="{Binding Editing.ShrinkToFit}" VerticalAlignment="Center" Margin="8,0,0,0"
                                              ToolTip="放不下时自动缩小字号，避免被裁掉" />
                                </StackPanel>

                                <TextBlock Grid.Row="9" Text="对齐" Style="{StaticResource Caption}" Visibility="{Binding Editing.IsText, Converter={StaticResource BoolVis}}" />
                                <ComboBox Grid.Row="9" Grid.Column="1" Margin="0,0,0,4"
                                          SelectedValue="{Binding Editing.Align}" SelectedValuePath="Tag"
                                          Visibility="{Binding Editing.IsText, Converter={StaticResource BoolVis}}">
                                    <ComboBoxItem Tag="{x:Static tm:HorizontalAlign.Left}">左对齐</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static tm:HorizontalAlign.Center}">居中</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static tm:HorizontalAlign.Right}">右对齐</ComboBoxItem>
                                </ComboBox>

                                <CheckBox Content="显示这个元素" IsChecked="{Binding Editing.Visible}" Grid.Row="10" Grid.Column="1" Margin="0,6,0,0" />
                            </Grid>

                            <TextBlock Text="校验提示" Style="{StaticResource StepTitle}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#C62828" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="目前没有问题，可以保存。" Foreground="#2E7D32" FontSize="11"
                                       Visibility="{Binding HasIssues, Converter={StaticResource BoolVisInv}}" />
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
