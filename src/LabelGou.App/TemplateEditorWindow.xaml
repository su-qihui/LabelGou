<Window x:Class="LabelGou.App.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:render="clr-namespace:LabelGou.App.Rendering"
        xmlns:tm="clr-namespace:LabelGou.Core.Templates;assembly=LabelGou.Core"
        xmlns:vm="clr-namespace:LabelGou.App.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{Binding Title}"
        Width="1180" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        FontFamily="Microsoft YaHei"
        Background="#F4F5F7">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="BoolVisInv"
                                                   xmlns:local="clr-namespace:LabelGou.App.Mvvm" />
        <!--
            StepTitle / Hint 在本窗口再定一份：App.xaml 的资源只有 Application.Current 存在时才能解析，
            而独立窗口必须能在没有 Application 的环境里被加载（单测就是这么加载它的）。
        -->
        <Style TargetType="TextBlock" x:Key="StepTitle">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#1A3A5C" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="56" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 工具条：按"加元素 → 摆位置 → 存起来"的操作顺序排，不按功能分类排 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,8">
            <WrapPanel>
                <TextBlock Text="模板名：" Style="{StaticResource Caption}" />
                <TextBox Width="170" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                <Separator Width="14" Background="Transparent" />

                <TextBlock Text="加元素：" Style="{StaticResource Caption}" />
                <Button Content="文本" Command="{Binding AddTextCommand}" ToolTip="加一个文本元素（可含字段占位符）" />
                <ToggleButton Content="曲线" IsChecked="{Binding IsBezierTool}" MinWidth="56" Margin="2,0"
                              ToolTip="贝塞尔工具（类 CorelDRAW）：点一下就是一个尖角，这一笔是直线；按下拖开就给这一点带上控制柄，刚画出来的那一段跟着弯。&#10;接着点下一处继续画，双击或回车收尾；Ctrl+Z 退一个落点，Esc 丢掉整条。&#10;画好后选中它，节点和控制柄可以直接在画布上拖。" />
                <ToggleButton Content="矩形框" IsChecked="{Binding IsRectTool}" MinWidth="56" Margin="2,0"
                              ToolTip="矩形工具（类 CorelDRAW）：在画布上按下拖出一只框、松手定形；只点一下不给一只默认尺寸（30×14mm）的框。Esc 取消拖到一半的框。" />
                <Button Content="图片" Command="{Binding AddImageCommand}" ToolTip="加 Logo 或条码图，会复制到模板目录" />
                <Button Content="复制" Command="{Binding DuplicateCommand}" ToolTip="复制选中元素（偏移 2mm）" />
                <Button Content="删除" Command="{Binding RemoveCommand}" ToolTip="删除选中元素，可撤销" />
                <Separator Width="14" Background="Transparent" />

                <TextBlock Text="对齐标签：" Style="{StaticResource Caption}" />
                <Button Content="贴左" Command="{Binding AlignCommand}" CommandParameter="Left" />
                <Button Content="横中" Command="{Binding AlignCommand}" CommandParameter="Center" />
                <Button Content="贴右" Command="{Binding AlignCommand}" CommandParameter="Right" />
                <Button Content="贴顶" Command="{Binding AlignCommand}" CommandParameter="Top" />
                <Button Content="纵中" Command="{Binding AlignCommand}" CommandParameter="Middle" />
                <Button Content="贴底" Command="{Binding AlignCommand}" CommandParameter="Bottom" />
                <Separator Width="14" Background="Transparent" />

                <Button Content="缩回纸内" Command="{Binding ShrinkIntoLabelCommand}"
                        ToolTip="选中的文字排到纸外时，按内容区能容下的比例把字号与盒高一起缩小并挪回纸内（撤销可退）" />
                <Separator Width="14" Background="Transparent" />

                <TextBlock Text="内边距：" Style="{StaticResource Caption}" />
                <Button Content="左" Command="{Binding PaddingCommand}" CommandParameter="Left" ToolTip="贴到内边距线（黄虚线）" />
                <Button Content="中" Command="{Binding PaddingCommand}" CommandParameter="Center" />
                <Button Content="右" Command="{Binding PaddingCommand}" CommandParameter="Right" />
                <Button Content="底" Command="{Binding PaddingCommand}" CommandParameter="Bottom" />
                <Separator Width="14" Background="Transparent" />

                <Button Content="上移一层" Command="{Binding MoveUpCommand}" ToolTip="往上一层层挪；原来只有「置最上/置最下」一步到顶，想微调一层只能整个弹到头，看着像图层动不了" />
                <Button Content="下移一层" Command="{Binding MoveDownCommand}" ToolTip="往下一层层挪" />
                <Button Content="置最上" Command="{Binding BringToFrontCommand}" ToolTip="压在别的元素上面" />
                <Button Content="置最下" Command="{Binding SendToBackCommand}" ToolTip="垫到别的元素下面" />
                <Button Content="撤销" Command="{Binding UndoCommand}" ToolTip="Ctrl+Z" />
                <Button Content="重做" Command="{Binding RedoCommand}" ToolTip="Ctrl+Y" />
                <Separator Width="14" Background="Transparent" />

                <CheckBox Content="网格" IsChecked="{Binding ShowGrid}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <CheckBox Content="吸附" IsChecked="{Binding SnapEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"
                          ToolTip="拖动时自动贴到边、中心线和别的元素上" />
                <CheckBox Content="贴网格" IsChecked="{Binding SnapToGrid}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="步长" Style="{StaticResource Caption}" />
                <ComboBox Width="64" SelectedItem="{Binding GridStepMm}" VerticalAlignment="Center">
                    <sys:Double>0.5</sys:Double>
                    <sys:Double>1</sys:Double>
                    <sys:Double>2</sys:Double>
                    <sys:Double>5</sys:Double>
                </ComboBox>
                <CheckBox Content="显示样例文字" IsChecked="{Binding ShowPreviewText}" VerticalAlignment="Center" Margin="8,0,8,0"
                          ToolTip="关掉就只看框，摆位置更快" />
                <Separator Width="14" Background="Transparent" />

                <Button Content="保存" FontWeight="Bold" Command="{Binding SaveCommand}" MinWidth="80" />
                <Button Content="另存为副本" Command="{Binding SaveAsCopyCommand}" />
                <Button Content="放弃改动" Command="{Binding RevertCommand}" />
            </WrapPanel>
        </Border>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="#333333" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Foreground="#C62828" ToolTip="有错误时保存会被拒绝">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="校验通过，可以保存" />
                            <Setter Property="Foreground" Value="#2E7D32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Text" Value="有错误没解决，保存会被拒绝（看右侧清单）" />
                                    <Setter Property="Foreground" Value="#C62828" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- 左：元素列表 + 插入字段 -->
            <GroupBox Grid.Column="0" Margin="0,0,10,0">
                <GroupBox.Header>
                    <TextBlock Text="元素（末尾=最上层）" Style="{StaticResource StepTitle}" />
                </GroupBox.Header>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="插入字段到标签：" Style="{StaticResource Hint}" />
                        <ComboBox ItemsSource="{Binding FieldOptions}"
                                  SelectedItem="{Binding SelectedFieldOption}"
                                  DisplayMemberPath="Display" MaxDropDownHeight="320" Margin="0,4,0,0" />
                        <Button Content="插入选中字段" Command="{Binding InsertFieldCommand}"
                                CommandParameter="{Binding SelectedFieldOption.Token}" Margin="0,6,0,0" MinWidth="110" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Elements}" SelectedItem="{Binding SelectedRow}"
                             HorizontalContentAlignment="Stretch" FontFamily="Consolas, Microsoft YaHei">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding GeometryText}" FontSize="10" Foreground="#888888" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <!-- 中：画布 -->
            <Border Grid.Column="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <render:TemplateEditorControl x:Name="Canvas" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="8,4,8,6"
                               Text="拖动摆位置；抓住边角小方块改大小；方向键微调（细调 Shift+方向键 = 0.1mm，粗调 Ctrl+方向键 = 2mm）；滚轮缩放，双击空白复位。" />
                </Grid>
            </Border>

            <!-- 右：属性 + 校验 -->
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="标签尺寸" Style="{StaticResource StepTitle}" />
                    </GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="宽(mm)" Style="{StaticResource Caption}" />
                        <TextBox Grid.Column="1" Text="{Binding WidthMm, StringFormat={}{0:0.##}}" Margin="0,0,6,4" />
                        <TextBlock Grid.Column="2" Text="高(mm)" Style="{StaticResource Caption}" />
                        <TextBox Grid.Column="3" Text="{Binding HeightMm, StringFormat={}{0:0.##}}" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Text="内边距" Style="{StaticResource Caption}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PaddingMm, StringFormat={}{0:0.##}}" Margin="0,0,6,4" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="外框线" Style="{StaticResource Caption}" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding BorderMm, StringFormat={}{0:0.##}}" Margin="0,0,0,4"
                                 ToolTip="0 表示不画外框" />
                        <TextBlock Grid.Row="2" Text="备注" Style="{StaticResource Caption}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Note}" />
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1">
                    <GroupBox.Header>
                        <TextBlock Text="选中元素" Style="{StaticResource StepTitle}" />
                    </GroupBox.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="点画布上的元素或左边列表选一个，就能改它的属性。"
                                       Style="{StaticResource Hint}"
                                       Visibility="{Binding HasSelection, Converter={StaticResource BoolVisInv}}" />
                            <Grid x:Name="PropsGrid" Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="类型" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Editing.KindText}" FontWeight="Bold" Margin="0,3,0,3" />

                                <TextBlock Grid.Row="1" Text="内容" Style="{StaticResource Caption}" Visibility="{Binding Editing.IsText, Converter={StaticResource BoolVis}}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Editing.Text}"
                                         AcceptsReturn="True" MinHeight="46" TextWrapping="Wrap"
                                         ToolTip="写 {{字段名}} 就是变量，例如 {{Consignee}}；纯文字也照印"
                                         Visibility="{Binding Editing.IsText, Converter={StaticResource BoolVis}}" />

                                <TextBlock Grid.Row="2" Text="图片" Style="{StaticResource Caption}" Visibility="{Binding Editing.IsImage, Converter={StaticResource BoolVis}}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Editing.ImagePath}"
                                         ToolTip="相对模板目录，或写绝对路径"
                                         Visibility="{Binding Editing.IsImage, Converter={StaticResource BoolVis}}" />

                                <TextBlock Grid.Row="3" Text="X(mm)" Style="{StaticResource Caption}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Editing.X, StringFormat={}{0:0.##}}" />
                                <TextBlock Grid.Row="4" Text="Y(mm)" Style="{StaticResource Caption}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Editing.Y, StringFormat={}{0:0.##}}" />

                                <TextBlock Grid.Row="5" Text="宽(mm)" Style="{StaticResource Caption}" Visibility="{Binding Editing.HasBox, Converter={StaticResource BoolVis}}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Editing.Width, StringFormat={}{0:0.##}}"
                                         Visibility="{Binding Editing.HasBox, Converter={StaticResource BoolVis}}" />
                                <TextBlock Grid.Row="6" Text="高(mm)" Style="{StaticResource Caption}" Visibility="{Binding Editing.HasBox, Converter={StaticResource BoolVis}}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Editing.Height, StringFormat={}{0:0.##}}"
                                         Visibility="{Binding Editing.HasBox, Converter={StaticResource BoolVis}}" />

                                <!--  矩形不在这格填线宽：第 17 行那颗「描边宽度」组合框才是它的位置（同一个 ThicknessMm，两处出现迟早有一处不跳）。  -->
                                <TextBlock Grid.Row="7" Text="线宽(mm)" Style="{StaticResource Caption}"
                                           Visibility="{Binding Editing.IsRect, Converter={StaticResource BoolVisInv}}" />
                                <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Editing.ThicknessMm, StringFormat={}{0:0.###}}"
                                         ToolTip="印刷常用 0.25~0.5"
                                         Visibility="{Binding Editing.IsRect, Converter={StaticResource BoolVisInv}}" />

                                <TextBlock Grid.Row="8" Text="字号(pt)" Style="{StaticResource Caption}" Visibility="{Binding Editing.IsText, Converter={StaticResource BoolVis}}" />
                                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4"
                                            Visibility="{Binding Editing.IsText, Converter={StaticResource BoolVis}}">
                                    <TextBox Width="52" Text="{Binding Editing.FontSizePt, StringFormat={}{0:0.#}}" />
                                    <CheckBox Content="加粗" IsChecked="{Binding Editing.Bold}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <CheckBox Content="自动缩字" IsChecked="{Binding Editing.ShrinkToFit}" VerticalAlignment="Center" Margin="8,0,0,0"
                                              ToolTip="放不下时自动缩小字号，避免被裁掉" />
                                </StackPanel>

                                <TextBlock Grid.Row="9" Text="对齐" Style="{StaticResource Caption}" Visibility="{Binding Editing.IsText, Converter={StaticResource BoolVis}}" />
                                <ComboBox Grid.Row="9" Grid.Column="1" Margin="0,0,0,4"
                                          SelectedValue="{Binding Editing.Align}" SelectedValuePath="Tag"
                                          Visibility="{Binding Editing.IsText, Converter={StaticResource BoolVis}}">
                                    <ComboBoxItem Tag="{x:Static tm:HorizontalAlign.Left}">左对齐</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static tm:HorizontalAlign.Center}">居中</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static tm:HorizontalAlign.Right}">右对齐</ComboBoxItem>
                                </ComboBox>

                                <TextBlock Grid.Row="10" Text="字体" Style="{StaticResource Caption}" Visibility="{Binding Editing.CanSetFont, Converter={StaticResource BoolVis}}" />
                                <ComboBox Grid.Row="10" Grid.Column="1" Margin="0,0,0,4" IsEditable="True"
                                          ItemsSource="{Binding SystemFonts}" Text="{Binding Editing.FontFamily, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="下拉选本机已装的系统字体，也可直接打字；缺的字体出片时会自动回退到默认字体"
                                          Visibility="{Binding Editing.CanSetFont, Converter={StaticResource BoolVis}}" />

                                <TextBlock Grid.Row="11" Text="旋转(°)" Style="{StaticResource Caption}" Visibility="{Binding Editing.CanRotate, Converter={StaticResource BoolVis}}" />
                                <TextBox Grid.Row="11" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Editing.RotationDeg, StringFormat={}{0:0.##}}"
                                         ToolTip="绕元素中心顺时针旋转；条码不许转（歪了扫描枪认不出）"
                                         Visibility="{Binding Editing.CanRotate, Converter={StaticResource BoolVis}}" />

                                <TextBlock Grid.Row="12" Text="字面拉伸" Style="{StaticResource Caption}" Visibility="{Binding Editing.CanStretchText, Converter={StaticResource BoolVis}}" />
                                <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4"
                                            ToolTip="把字身抻宽/压扁（1=原样）；不等比，只改字面不改折行。也可直接拖文字四边的手柄"
                                            Visibility="{Binding Editing.CanStretchText, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="横" VerticalAlignment="Center" FontSize="11" />
                                    <TextBox Width="46" Margin="3,0,0,0" Text="{Binding Editing.TextScaleX, StringFormat={}{0:0.###}}" />
                                    <TextBlock Text="纵" VerticalAlignment="Center" FontSize="11" Margin="10,0,0,0" />
                                    <TextBox Width="46" Margin="3,0,0,0" Text="{Binding Editing.TextScaleY, StringFormat={}{0:0.###}}" />
                                </StackPanel>

                                <CheckBox Content="显示这个元素" IsChecked="{Binding Editing.Visible}" Grid.Row="13" Grid.Column="1" Margin="0,6,0,0" />

                                <TextBlock Grid.Row="14" Text="折行宽度" Style="{StaticResource Caption}" Visibility="{Binding Editing.HasText, Converter={StaticResource BoolVis}}" />
                                <TextBox Grid.Row="14" Grid.Column="1" Margin="0,4,0,4" Text="{Binding Editing.WrapWidthMm, StringFormat={}{0:0.##}}"
                                         ToolTip="0 = 永不折行：内容多长排多长，排到纸外就看得见地超出去，用工具栏「缩回纸内」收回。填一个正值（例如与宽相同）就恢复按这个宽度折行与缩字号。"
                                         Visibility="{Binding Editing.HasText, Converter={StaticResource BoolVis}}" />

                                <!--  墨色（第 47 棒）：这一支笔的颜色由 Core 的 LabelColor 存两端原值，
                                      画布 / ③④ 步预览 / 打印 / 位图 / SVG 五个出口读同一份（RenderRules.InkOf、InkHex）。
                                      默认黑 = 这一格为空，所以老模板一个字都不变。  -->
                                <TextBlock Grid.Row="15" Text="墨色" Style="{StaticResource Caption}"
                                           Visibility="{Binding Editing.CanTintInk, Converter={StaticResource BoolVis}}" />
                                <WrapPanel Grid.Row="15" Grid.Column="1" Margin="0,4,0,4"
                                            Visibility="{Binding Editing.CanTintInk, Converter={StaticResource BoolVis}}">
                                    <Button x:Name="InkPicker" Width="30" Height="18" VerticalAlignment="Center"
                                            Background="{Binding Editing.PenSwatch}" BorderBrush="#8A8F98"
                                            Command="{Binding Editing.OpenPenEditorCommand}"
                                            ToolTip="选调描边（笔色）这一支墨。唛头是印刷活，分量按 CMYK 百分数填。" />
                                    <TextBlock Text="{Binding Editing.PenSummary}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" />
                                    <Popup PlacementTarget="{Binding ElementName=InkPicker}" Placement="Top"
                                           HorizontalOffset="-482" VerticalOffset="-6"
                                           StaysOpen="False" AllowsTransparency="True"
                                           IsOpen="{Binding Editing.InkPopupOpen, Mode=TwoWay}">
                                        <Border Background="White" BorderBrush="#B7BCC5" BorderThickness="1" Padding="10" Width="512">
                                            <StackPanel>
                                        <TextBlock Text="{Binding Editing.InkTargetText}" Margin="0,0,0,8" FontSize="11" FontWeight="Bold"
                                                   Visibility="{Binding Editing.IsRect, Converter={StaticResource BoolVis}}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!--  调色盘（第 47 棒补刀）：方块横轴=饱和度、纵轴=明度，右边那条带子选色相。
                                                      鼠标只交 0~1 的比例，颜色怎么落、面板跳不跳档全在 EditableElement 里。  -->
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Grid Width="{x:Static vm:EditableElement.PickerSquareW}" Height="{x:Static vm:EditableElement.PickerSquareH}">
                                                            <Border Background="{Binding Editing.PickerSvFill}" />
                                                            <Border>
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#00000000" Offset="0" />
                                                                        <GradientStop Color="#FF000000" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <Canvas IsHitTestVisible="False">
                                                                <Grid Canvas.Left="{Binding Editing.PickerThumbX}" Canvas.Top="{Binding Editing.PickerThumbY}" Margin="-7,-7,0,0">
                                                                    <Ellipse Width="14" Height="14" Stroke="#66000000" StrokeThickness="1" />
                                                                    <Ellipse Width="10" Height="10" Stroke="White" StrokeThickness="1.5" />
                                                                </Grid>
                                                            </Canvas>
                                                            <Border x:Name="InkSvArea" Background="Transparent" BorderBrush="#B7BCC5" BorderThickness="1" Cursor="Hand"
                                                                    MouseLeftButtonDown="InkSvArea_MouseLeftButtonDown"
                                                                    MouseMove="InkSvArea_MouseMove"
                                                                    MouseLeftButtonUp="InkPickArea_MouseLeftButtonUp" />
                                                        </Grid>

                                                        <Grid Grid.Column="2" Width="18" Height="{x:Static vm:EditableElement.PickerHueBarH}">
                                                            <Border>
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#FFFF0000" Offset="0" />
                                                                        <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                                                                        <GradientStop Color="#FF00FF00" Offset="0.3333" />
                                                                        <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                                                        <GradientStop Color="#FF0000FF" Offset="0.6667" />
                                                                        <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                                                                        <GradientStop Color="#FFFF0000" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <Canvas IsHitTestVisible="False">
                                                                <Rectangle Canvas.Top="{Binding Editing.PickerHueThumbY}" Width="18" Height="5" Margin="0,-2.5,0,0"
                                                                         Fill="White" Stroke="#66000000" StrokeThickness="1" />
                                                            </Canvas>
                                                            <Border x:Name="InkHueArea" Background="Transparent" BorderBrush="#B7BCC5" BorderThickness="1" Cursor="Hand"
                                                                    MouseLeftButtonDown="InkHueArea_MouseLeftButtonDown"
                                                                    MouseMove="InkHueArea_MouseMove"
                                                                    MouseLeftButtonUp="InkPickArea_MouseLeftButtonUp" />
                                                        </Grid>
                                                    </Grid>

                                                    <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="#8A8F98" TextWrapping="Wrap" MaxWidth="276"
                                                               Text="拖这里选色，右边的墨量四格跟着变。这一屏只是近似，落墨以印刷店的 profile 为准。" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <RadioButton Content="CMYK（印刷分量）" GroupName="InkSpace" FontSize="11"
                                                                     IsChecked="{Binding Editing.InkUsesCmyk}" />
                                                        <RadioButton Content="RGB（屏幕）" GroupName="InkSpace" FontSize="11" Margin="12,0,0,0"
                                                                     IsChecked="{Binding Editing.InkUsesRgb}" />
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding Editing.InkUsesCmyk, Converter={StaticResource BoolVis}}">
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="26" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="44" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="C" VerticalAlignment="Center" FontSize="11" />
                                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    Value="{Binding Editing.InkC}" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding Editing.InkC}" />
                                                        </Grid>
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="26" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="44" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="M" VerticalAlignment="Center" FontSize="11" />
                                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    Value="{Binding Editing.InkM}" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding Editing.InkM}" />
                                                        </Grid>
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="26" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="44" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Y" VerticalAlignment="Center" FontSize="11" />
                                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    Value="{Binding Editing.InkY}" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding Editing.InkY}" />
                                                        </Grid>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="26" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="44" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="K" VerticalAlignment="Center" FontSize="11" />
                                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    Value="{Binding Editing.InkK}" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding Editing.InkK}" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding Editing.InkUsesRgb, Converter={StaticResource BoolVis}}">
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="26" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="44" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="R" VerticalAlignment="Center" FontSize="11" />
                                                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Editing.InkR}" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding Editing.InkR}" />
                                                        </Grid>
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="26" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="44" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="G" VerticalAlignment="Center" FontSize="11" />
                                                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Editing.InkG}" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding Editing.InkG}" />
                                                        </Grid>
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="26" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="44" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="B" VerticalAlignment="Center" FontSize="11" />
                                                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Editing.InkB}" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding Editing.InkB}" />
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="十六进制" VerticalAlignment="Center" FontSize="11" Width="52" />
                                                            <TextBox Width="96" Text="{Binding Editing.InkHex, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTip="#rrggbb 也认 cmyk(C M Y K)；从 Corel 或网页抄来的写法可以直接粘" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Border Height="16" Margin="0,8,0,0" Background="{Binding Editing.InkSwatch}" BorderBrush="#DDDDDD" BorderThickness="1" />

                                                    <TextBlock Text="常用（头一颗＝无颜色，斜杠那块）" FontSize="11" Foreground="#666666" Margin="0,8,0,2" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Width="28" Height="18" Margin="0,0,5,0" Padding="0" Background="White" BorderBrush="#8A8F98"
                                                                Command="{Binding Editing.NoInkCommand}" ToolTip="无颜色＝关掉此刻在编辑的这一支：从填充那颗进来就取消填充，从描边那颗进来就不画边框。&#10;已经关着时这颗是灰的；再点色块可以重新上色。">
                                                            <Canvas Width="26" Height="16" ClipToBounds="True">
                                                                <Line X1="0" Y1="16" X2="26" Y2="0" Stroke="#D23A0A" StrokeThickness="2" />
                                                            </Canvas>
                                                        </Button>
                                                    <ItemsControl ItemsSource="{x:Static vm:EditableElement.InkPresets}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Width="28" Height="18" Margin="0,0,5,0" ToolTip="{Binding Name}"
                                                                        Background="{Binding Swatch}" BorderBrush="#8A8F98"
                                                                        Command="{Binding DataContext.Editing.ApplyInkPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    </StackPanel>

                                                    <Button Content="恢复默认（黑）" Command="{Binding Editing.ResetInkCommand}" Padding="6,1" Margin="0,8,0,0"
                                                            HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </WrapPanel>

                                <TextBlock Grid.Row="16" Text="曲线" Style="{StaticResource Caption}"
                                           Visibility="{Binding Editing.IsCurve, Converter={StaticResource BoolVis}}" />
                                <WrapPanel Grid.Row="16" Grid.Column="1" Margin="0,4,0,4"
                                            Visibility="{Binding Editing.IsCurve, Converter={StaticResource BoolVis}}">
                                    <TextBlock VerticalAlignment="Center" FontSize="11"
                                               Text="{Binding Editing.NodeCount, StringFormat='共 {0} 个节点'}" />
                                    <Button Content="拉直" Command="{Binding Editing.StraightenCommand}" Margin="10,0,0,0" Padding="6,1"
                                            ToolTip="所有控制柄归零：节点位置不动，每段变成直线段（想退回直线又不想删了重画时用）" />
                                    <Button Content="只留两端" Command="{Binding Editing.FlattenToEndsCommand}" Margin="6,0,0,0" Padding="6,1"
                                            ToolTip="删掉所有中间节点与柄，回到从前那条两点直线" />
                                    <Separator Width="12" Background="Transparent" />
                                    <Button Content="尖突" Command="{Binding DataContext.NodeCornerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Margin="0,0,0,0" Padding="6,1"
                                            ToolTip="使节点成为尖突（CorelDRAW 同名命令）：收掉这个点的两根柄，曲线在此折断成折角。" />
                                    <Button Content="平滑" Margin="6,0,0,0" Padding="6,1"
                                            Command="{Binding DataContext.NodeSmoothCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="平滑节点：两根柄压到同一条方向线上，但各自长度保留——过点顺滑、两侧弯度可以不一样。" />
                                    <Button Content="对称" Margin="6,0,0,0" Padding="6,1"
                                            Command="{Binding DataContext.NodeSymmetricCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="生成对称节点：两根柄共线而且等长。" />
                                    <TextBlock Text="（先点住要改的那个节点）" VerticalAlignment="Center" Margin="6,0,0,0"
                                               FontSize="10" Foreground="#8A8F98" />
                                    <TextBlock Text="节点和柄在画布上直接拖" VerticalAlignment="Center" Margin="10,0,0,0"
                                               FontSize="10" Foreground="#8A8F98" />
                                </WrapPanel>

                                <!--  矩形外观（第 50 棒）。描边宽度仍用上面第 7 行那个「线宽」，这里不另开一格——
                                      同一份数据在面板上出现两次，迟早出现改一处另一处不跳的假象。  -->
                                <!--  矩形外观（第 50 棒，照 CorelDRAW 的样子摆）：两支墨各自一颗色块、描边宽度挨着描边开关、
                                      圆角是"四颗角 + 旁边一颗锁"（锁＝四个角一起调，与 CDR 那颗挂锁同义）。  -->
                                <!--  矩形外观（第 50 棒，照 CorelDRAW 的样子摆）。一行只放两三件东西：
                                      上一版把填充、描边、宽度、四颗角全挤在一行，右边整截被挤出面板看不见。  -->
                                <TextBlock Grid.Row="17" Text="矩形" Style="{StaticResource Caption}"
                                           Visibility="{Binding Editing.IsRect, Converter={StaticResource BoolVis}}" />
                                <StackPanel Grid.Row="17" Grid.Column="1" Margin="0,4,0,4"
                                            Visibility="{Binding Editing.IsRect, Converter={StaticResource BoolVis}}">
                                    <WrapPanel>
                                        <CheckBox Content="填充" Width="52" VerticalAlignment="Center" IsChecked="{Binding Editing.FillEnabled}"
                                                  ToolTip="矩形内部上色。关掉＝不填充（与老模板同形，一个字段都不写）。" />
                                        <Button Width="30" Height="18" VerticalAlignment="Center"
                                                Background="{Binding Editing.FillSwatch}" BorderBrush="#8A8F98"
                                                Command="{Binding Editing.OpenFillEditorCommand}"
                                                ToolTip="选调填充这一支墨。它和下面那颗「描边」是两支独立的墨，改一支不动另一支。&#10;要取消填充：点开它，用弹层里那颗斜杠的「无颜色」。" />
                                        <TextBlock Text="{Binding Editing.FillSummary}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <CheckBox Content="描边" Width="52" VerticalAlignment="Center"
                                                  IsChecked="{Binding Editing.ShowsStroke}"
                                                  ToolTip="画不画那条边框线，粗细就是右边那格。关掉后若又没填充，这个矩形在纸上什么都不剩（校验会提醒）。" />
                                        <ComboBox IsEditable="True" Width="88" VerticalAlignment="Center"
                                                  Text="{Binding Editing.ThicknessText, UpdateSourceTrigger=LostFocus}"
                                                  ItemsSource="{x:Static vm:EditableElement.ThicknessPresets}"
                                                  ItemStringFormat="{}{0:0.##} mm"
                                                  ToolTip="描边粗细（毫米）。直接打字——0.35、0.35 mm、0.35毫米 都认；下拉里是常用档。&#10;认不出的写法退回上一个数，不会把框悄悄清成 0。" />
                                        <TextBlock Text="线宽(mm)" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="11" Foreground="#8A8F98" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <TextBlock Text="圆角(mm)" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBox Width="46" VerticalAlignment="Center"
                                                 Text="{Binding Editing.CornerRadiusMm, StringFormat={}{0:0.##}}"
                                                 ToolTip="0 = 直角。超过短边一半时按短边一半画（再大就成了胶囊，不是更圆），校验会说明。" />
                                        <TextBlock Text="半径，右边四颗挑圆哪几个角" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   FontSize="10" Foreground="#8A8F98" TextTrimming="CharacterEllipsis" />
                                    </WrapPanel>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="4" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ToggleButton Content="左上" MinWidth="40" Grid.Row="0" Grid.Column="0"
                                                          IsChecked="{Binding Editing.CornerTopLeft}" />
                                            <ToggleButton Content="右上" MinWidth="40" Grid.Row="0" Grid.Column="2"
                                                          IsChecked="{Binding Editing.CornerTopRight}" />
                                            <ToggleButton Content="左下" MinWidth="40" Grid.Row="2" Grid.Column="0"
                                                          IsChecked="{Binding Editing.CornerBottomLeft}" />
                                            <ToggleButton Content="右下" MinWidth="40" Grid.Row="2" Grid.Column="2"
                                                          IsChecked="{Binding Editing.CornerBottomRight}" />
                                        </Grid>
                                        <ToggleButton Content="四个角一起" Grid.Column="4" VerticalAlignment="Center"
                                                      IsChecked="{Binding Editing.CornersAll}"
                                                      ToolTip="就是 CorelDRAW 那颗锁：锁上＝四个角一起圆（这时旁边四颗没意义）；&#10;打开＝用旁边四颗逐角挑要圆哪几个。" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="校验提示" Style="{StaticResource StepTitle}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#C62828" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="目前没有问题，可以保存。" Foreground="#2E7D32" FontSize="11"
                                       Visibility="{Binding HasIssues, Converter={StaticResource BoolVisInv}}" />
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
