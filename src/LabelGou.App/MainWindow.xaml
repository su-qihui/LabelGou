<Window x:Class="LabelGou.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:render="clr-namespace:LabelGou.App.Rendering"
        xmlns:services="clr-namespace:LabelGou.App.Services"
        xmlns:mvvm="clr-namespace:LabelGou.App.Mvvm"
        Title="LabelGou · 唛头标签助手"
        Width="1320" Height="860"
        MinWidth="1080" MinHeight="700"
        FontFamily="Microsoft YaHei" FontSize="12.5"
        Background="#F4F6F8"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 标题栏不带版本号：构造里由 AppInfo.WindowTitle 从程序集版本填（XAML 属性之间不能放注释，故说明落在内容区） -->
        <!-- 一步只露一块：每个步骤面板拿自己的步骤号去问转换器（见 Mvvm.StepIndexToVisibilityConverter） -->
        <mvvm:StepIndexToVisibilityConverter x:Key="StepEq" />
        <!--  「只在纸与模板对不上时才插一句」的提示与按钮用（空串就整块收起，不留一行空白） -->
        <mvvm:StringNotEmptyToVisibilityConverter x:Key="HasText" />
    </Window.Resources>

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="打开数据文件…(_O)" Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="智能识别单据…（照片 / 截图 / Word）(_R)" Click="OnRecognizeClick" InputGestureText="Ctrl+Shift+R" />
                <MenuItem Header="模型（AI）设置与调试…(_A)" Click="OnAiSettingsClick"
                      ToolTip="选本机 Ollama 还是云端（阿里云百炼 / DeepSeek），并当场试一次看模型到底答什么、多少秒" />
                <MenuItem Header="和模型对话（问它怎么调）…(_C)" Click="OnAiChatClick"
                      ToolTip="多轮自由问答，可以附一张样张图。聊出来的内容不会自动改唛头，也不碰模板与毫米" />
                <Separator />
                <MenuItem Header="打印整版…(_P)" Command="{Binding Export.PrintCommand}" InputGestureText="Ctrl+P" />
                <MenuItem Header="导出 PDF…" Command="{Binding Export.ExportPdfCommand}" />
                <MenuItem Header="导出整版图片 PNG…" Command="{Binding Export.ExportPngCommand}" />
                <MenuItem Header="导出多页 TIFF…" Command="{Binding Export.ExportTiffCommand}" />
                <MenuItem Header="导出整版 SVG（给 CorelDRAW）…" Command="{Binding Export.ExportSvgCommand}" />
                <Separator />
                <MenuItem Header="退出(_X)" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="拆下 / 收回 AI 助手窗口(_D)" Click="OnDetachAiClick"
                          ToolTip="只把 AI 那一块拆成独立窗口（AI 在窗外、排版在窗内，摆在一起对照）；再点一下收回原位" />
                <Separator />
                <MenuItem Header="放大" Command="{Binding ZoomInCommand}" />
                <MenuItem Header="缩小" Command="{Binding ZoomOutCommand}" />
            </MenuItem>
            <MenuItem Header="模板(_T)">
                <MenuItem Header="新建空白模板…" Click="OnNewTemplateClick" />
                <MenuItem Header="编辑当前模板…(_E)" Click="OnEditTemplateClick" InputGestureText="Ctrl+T" />
                <MenuItem Header="从当前模板另存副本…" Click="OnDuplicateTemplateClick" />
                <Separator />
                <MenuItem Header="从底稿导入…（SVG / CDR）(_I)" Click="OnImportBackgroundClick" InputGestureText="Ctrl+I" />
                <MenuItem Header="导入模板文件…" Click="OnImportTemplateClick" />
                <MenuItem Header="导出当前模板为文件…" Click="OnExportTemplateClick" />
                <MenuItem Header="删除当前用户模板…" Click="OnDeleteTemplateClick" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="查看诊断日志…" Click="OnOpenLogClick" />
                <MenuItem Header="关于 LabelGou" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <!-- 左栏可以拖宽了（用户 2026-09-08：表格显示区太小）：给个下限，免得拖成一条缝再也不会调 -->
                <ColumnDefinition Width="470" MinWidth="320" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="#E1E5EA" ShowsPreview="False"
                          ToolTip="按住左右拖：改左侧向导区的宽度（表格列多看不全时就往右拖）" />

            <!-- ==================== 左侧：五步向导（一次只露一步） ====================
                 以前六个 GroupBox 从上到下全摊在一个滚动条里：想改纸规得滚过整屏字段，新加的能力
                 （行式模板、整批固定值）全藏在中部，用户打开软件看不出任何变化。现在步骤条钉在顶上、
                 内容区一步一块、上一步 / 下一步钉在底下，三样都不跟着内容滚。 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         ItemsSource="{Binding StepTitles}"
                         SelectedIndex="{Binding StepIndex, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ToolTip="点任意一步直接跳过去，不必按顺序走">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="9,6" />
                            <Setter Property="Margin" Value="0,0,4,6" />
                            <Setter Property="FontSize" Value="12.5" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,2,6,0">
                  <StackPanel>

                    <!-- ===== 第 1 步：导入数据 ===== -->
                    <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource StepEq}, ConverterParameter=0}">
                    <GroupBox>
                        <GroupBox.Header>
                            <TextBlock Text="打开工厂发来的数据（Excel / CSV）" Style="{StaticResource StepTitle}" />
                        </GroupBox.Header>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SourcePath, Mode=OneWay}" IsReadOnly="True"
                                         ToolTip="{Binding SourcePath}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="打开…" Command="{Binding OpenFileCommand}" Margin="6,0,0,0" />
                            </Grid>

                            <Button Content="智能识别单据…（照片 / 截图 / Word）" Click="OnRecognizeClick"
                                    HorizontalAlignment="Left" Margin="0,6,0,0"
                                    ToolTip="本地 OCR + 本机大模型双通道抽取；结果要在核对窗口里逐条确认才会变成数据（Ctrl+Shift+R）" />

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="工作表：" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" />
                            </Grid>

                            <TextBlock Text="{Binding HeaderInfoText}" Style="{StaticResource Hint}" Margin="0,6,0,4" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="表格显示区：" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="PreviewTableSizeBox"
                                          ItemsSource="{Binding PreviewTableHeightOptions}"
                                          SelectedItem="{Binding SelectedPreviewTableHeight}"
                                          DisplayMemberPath="Label"
                                          ToolTip="嫌小就选中 / 大（这个选择会记住，下次启动还在）；要横向变宽就拖左栏与右边之间那条分隔线" />
                            </Grid>

                            <Border BorderBrush="#D8DDE3" BorderThickness="1" Height="{Binding PreviewTableHeight}" Background="White">
                                <DataGrid ItemsSource="{Binding PreviewTable}"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="All"
                                          SelectionUnit="Cell"
                                          FontSize="11.5"
                                          RowHeaderWidth="0" />
                            </Border>
                        </StackPanel>
                    </GroupBox>
                    </StackPanel>

                    <!-- ===== 第 2 步：连接字段 ===== -->
                    <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource StepEq}, ConverterParameter=1}">
                    <GroupBox>
                        <GroupBox.Header>
                            <TextBlock Text="把表格列连到唛头字段" Style="{StaticResource StepTitle}" />
                        </GroupBox.Header>
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="自动推荐" Command="{Binding AutoSuggestCommand}" />
                                <Button Content="应用映射" Command="{Binding ApplyMappingCommand}" FontWeight="Bold" />
                                <Button Content="保存方案" Command="{Binding SaveProfileCommand}" />
                                <Button Content="删除方案" Command="{Binding DeleteProfileCommand}" />
                                <Button Content="整批固定值…" Click="OnEditFixedValuesClick"
                                        ToolTip="表里没有那一列、但整批都要印同一个值（如客户名 BOLAROM）就在这里填一次" />
                            </WrapPanel>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="方案名称：" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="已存方案：" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SavedProfiles}"
                                          SelectedItem="{Binding SelectedSavedProfile}"
                                          DisplayMemberPath="DisplayName" />
                            </Grid>

                            <CheckBox Content="没有件号数据时，按行序自动补件号与总件数"
                                      IsChecked="{Binding AutoNumberCartons}" Margin="0,8,0,4" />

                            <Border BorderBrush="#D8DDE3" BorderThickness="1" Background="White" MaxHeight="330">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FieldRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,2" >
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="128" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="112" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Rectangle Width="6" Height="6" Margin="0,0,4,0"
                                                                   VerticalAlignment="Center">
                                                            <Rectangle.Style>
                                                                <Style TargetType="Rectangle">
                                                                    <Setter Property="Fill" Value="#C0C6CC" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Mapped}" Value="True">
                                                                            <Setter Property="Fill" Value="#2E7D32" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Rectangle.Style>
                                                        </Rectangle>
                                                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding FieldKey}" />
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1" Margin="4,0"
                                                              ItemsSource="{Binding Columns}"
                                                              SelectedValue="{Binding ColumnIndex}"
                                                              SelectedValuePath="Index" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SampleValue}"
                                                               Style="{StaticResource Hint}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               ToolTip="该列第一条数据的值，用来确认连对了没有" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                    </StackPanel>

                    <!-- ===== 第 3 步：选模板 ===== -->
                    <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource StepEq}, ConverterParameter=2}">
                    <GroupBox>
                        <GroupBox.Header>
                            <TextBlock Text="选唛头模板（内置 + 自己拖的 + 从样件做的）" Style="{StaticResource StepTitle}" />
                        </GroupBox.Header>
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding TemplateOptions}"
                                      SelectedItem="{Binding SelectedTemplate}"
                                      DisplayMemberPath="DisplayName" />
                            <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="新建模板…" Click="OnNewTemplateClick" MinWidth="86" Margin="0,0,6,0"
                                        ToolTip="从空白开始拖一套自己的唛头" />
                                <Button Content="编辑模板…" Click="OnEditTemplateClick" MinWidth="86" Margin="0,0,6,0"
                                        ToolTip="把上面选中的模板拖改一下（内置模板会先自动存一份副本）" />
                                <Button Content="从底稿导入…" Click="OnImportBackgroundClick" MinWidth="96" Margin="0,0,6,0"
                                        ToolTip="拿 CorelDRAW/AI 导出的 SVG 当底图，对得上样例数据的文字可以直接绑字段（Ctrl+I）" />
                                <!--  删除以前只藏在「模板(T)」菜单里，用户找不到（2026-09-09：「模板删除的UI调到模板栏目」）。
                                      菜单那一行仍留着：同一个 OnDeleteTemplateClick，不开第二套删除逻辑。  -->
                                <Button Content="删除这份模板…" Click="OnDeleteTemplateClick" MinWidth="106"
                                        ToolTip="只删自己存的用户模板（内置模板删不了也不占磁盘）；删前会弹一次确认" />
                            </WrapPanel>
                            <TextBlock Text="{Binding TemplateInfoText}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                            <!--  纸与模板对不上时说一句该换哪一份，而不是让用户去拼版告警里自己找  -->
                            <TextBlock Text="{Binding TemplateSheetHint}" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Foreground="#B25A00" TextWrapping="Wrap">
                                <TextBlock.Visibility>
                                    <Binding Path="TemplateSheetHint" Converter="{StaticResource HasText}" />
                                </TextBlock.Visibility>
                            </TextBlock>
                            <Button Content="换成这张纸配套的模板" Command="{Binding UseMatchingTemplateCommand}"
                                    HorizontalAlignment="Left" Margin="0,4,0,0">
                                <Button.Visibility>
                                    <Binding Path="TemplateSheetHint" Converter="{StaticResource HasText}" />
                                </Button.Visibility>
                            </Button>
                        </StackPanel>
                    </GroupBox>

                    <!-- ===== 条码栏目（第 17 棒，用户 2026-09-09：「加入条码栏目—条码一般是不同的表格里会有数字要对应填入」）===== -->
                    <!-- 列的下拉直接拿这张表真有的列名，不让人猜占位符怎么写；下面那句实时预览拿第一行真值试编一次。 -->
                    <GroupBox Margin="0,8,0,0">
                        <GroupBox.Header>
                            <TextBlock Text="条码（可选：让它读表里的某一列）" Style="{StaticResource StepTitle}" />
                        </GroupBox.Header>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="制式：" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Barcode.SymbologyOptions}"
                                          SelectedItem="{Binding Barcode.SelectedSymbology}"
                                          DisplayMemberPath="Label" />
                                <TextBlock Grid.Column="2" Text="位置：" VerticalAlignment="Center" Margin="10,0,2,0" />
                                <ComboBox Grid.Column="3" ItemsSource="{Binding Barcode.PlacementOptions}"
                                          SelectedItem="{Binding Barcode.SelectedPlacement}"
                                          DisplayMemberPath="Label" />
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="读哪一列：" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Barcode.SourceOptions}"
                                          SelectedItem="{Binding Barcode.SelectedSource}"
                                          ToolTip="列名直接来自刚打开的那张表。已连到内置字段的那一列会用字段取值，没连上的按列名直取。" />
                            </Grid>

                            <!--  手填框只在「读哪一列 = 手填固定数字」时可输入。绑到真的业务判据上（不绑一个占位的 x:Name），
                                 否则用户会以为填了这格也能让整批共码，而实际起作用的是上面那个下拉。  -->
                            <TextBox Text="{Binding Barcode.FixedText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,0"
                                     IsEnabled="{Binding Barcode.IsFixedTextEntry}"
                                     ToolTip="只有整批共用一个码时才手填；正常情况请选上面那一列" />

                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="高(mm)：" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Barcode.HeightMm, UpdateSourceTrigger=PropertyChanged}"
                                         Width="46" VerticalAlignment="Center" Margin="0,0,12,0"
                                         ToolTip="条码带的高（含下面那行可读数字）。常用 12~18 mm" />
                                <CheckBox Content="条码下方印那串数字" IsChecked="{Binding Barcode.ShowText}"
                                          VerticalAlignment="Center" Margin="0,0,12,0"
                                          ToolTip="默认要：扫不出时人还能报号" />
                                <Button Content="加到当前模板" Command="{Binding Barcode.AddBarcodeCommand}" FontWeight="Bold"
                                        ToolTip="内置模板会先另存成一份自己的副本再改；改完在预览里就能看见，拖位置去「编辑模板…」" />
                            </WrapPanel>

                            <TextBlock Text="{Binding Barcode.Preview}" Foreground="{Binding Barcode.PreviewBrush}"
                                       Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </GroupBox>
                    </StackPanel>

                    <!-- ===== 第 4 步：拼版与编号 ===== -->
                    <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource StepEq}, ConverterParameter=3}">
                    <GroupBox>
                        <GroupBox.Header>
                            <TextBlock Text="整版拼版与件号编号" Style="{StaticResource StepTitle}" />
                        </GroupBox.Header>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="纸规：" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Sheet.SheetOptions}"
                                          SelectedItem="{Binding Sheet.SelectedSheetOption}"
                                          DisplayMemberPath="DisplayName" />
                            </Grid>

                            <!--  同一条 ③ 步那句提示：选完纸就地告诉他模板配不上（四档开法的名字与模板是一一对应的）  -->
                            <TextBlock Text="{Binding TemplateSheetHint}" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Foreground="#B25A00" TextWrapping="Wrap">
                                <TextBlock.Visibility>
                                    <Binding Path="TemplateSheetHint" Converter="{StaticResource HasText}" />
                                </TextBlock.Visibility>
                            </TextBlock>

                            <UniformGrid Columns="4" Margin="0,6,0,0">
                                <TextBlock Text="纸宽" Style="{StaticResource Hint}" />
                                <!--  一页一枚（FollowsLabel）下这两个框每次都被引擎按标签尺寸覆写，能输入就是假旋钮：直接灰掉并说清为什么  -->
                                <TextBox Text="{Binding Sheet.Working.PaperWidthMm, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Sheet.PaperSizeEditable}"
                                         ToolTip="跟随标签尺寸：纸宽 = 唛头宽 + 左右页边，这里填了不生效" />
                                <TextBlock Text="纸高" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Sheet.Working.PaperHeightMm, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Sheet.PaperSizeEditable}"
                                         ToolTip="跟随标签尺寸：纸高 = 唛头高 + 上下页边，这里填了不生效" />
                            </UniformGrid>

                            <UniformGrid Columns="4" Margin="0,4,0,0">
                                <TextBlock Text="左边" Style="{StaticResource Hint}" />
                                <TextBox Text="{Binding Sheet.Working.MarginLeftMm, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="上边" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Sheet.Working.MarginTopMm, UpdateSourceTrigger=PropertyChanged}" />
                            </UniformGrid>

                            <UniformGrid Columns="4" Margin="0,4,0,0">
                                <TextBlock Text="右边" Style="{StaticResource Hint}" />
                                <TextBox Text="{Binding Sheet.Working.MarginRightMm, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="下边" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Sheet.Working.MarginBottomMm, UpdateSourceTrigger=PropertyChanged}" />
                            </UniformGrid>

                            <UniformGrid Columns="4" Margin="0,4,0,0">
                                <TextBlock Text="列间距" Style="{StaticResource Hint}" />
                                <TextBox Text="{Binding Sheet.Working.GutterXMm, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="行间距" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Sheet.Working.GutterYMm, UpdateSourceTrigger=PropertyChanged}" />
                            </UniformGrid>

                            <UniformGrid Columns="4" Margin="0,4,0,0">
                                <TextBlock Text="列数" Style="{StaticResource Hint}" />
                                <TextBox Text="{Binding Sheet.Working.Columns, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="填 0 表示按可用宽度自动密排" />
                                <TextBlock Text="行数" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Sheet.Working.Rows, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="填 0 表示按可用高度自动密排" />
                            </UniformGrid>

                            <WrapPanel Margin="0,6,0,0">
                                <CheckBox Content="允许旋转省料" IsChecked="{Binding Sheet.Working.AllowRotate}" VerticalAlignment="Center" />
                                <CheckBox Content="套准十字" IsChecked="{Binding Sheet.Working.RegistrationMarks}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <CheckBox Content="横向用纸" IsChecked="{Binding Sheet.Working.Landscape}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <CheckBox Content="一页只排同一枚" IsChecked="{Binding Sheet.RepeatSameLabelPerPage}" Margin="12,0,0,0" VerticalAlignment="Center"
                                          ToolTip="默认勾上（2026-09-08 用户口径「开四就是一张排 4 个一模一样的」）：一枚唛头占一张纸，页内铺满每页枚数份全同唛头，不留白格。&#10;上纸枚数 = 唛头数 × 每页枚数（一开四就是 4 倍料）；这枚唛头要出几张纸由「按哪一列数张数」说，不是由这里乘。&#10;关掉就是按顺序铺满整页、跨款混排（一行几箱拼在同一页上），更省纸。两种各要几页，下面那行方案会同时报出来。" />
                            </WrapPanel>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="裁切线：" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Sheet.CropMarkOptions}"
                                          SelectedItem="{Binding Sheet.SelectedCropMark}"
                                          DisplayMemberPath="Label" />
                                <Button Grid.Column="2" Content="另存为我的纸规…" Command="{Binding Sheet.SaveSheetAsCommand}" Margin="6,0,0,0" />
                            </Grid>

                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="改完了，重算整版" Command="{Binding Sheet.ApplySheetCommand}" FontWeight="Bold" />
                                <Button Content="恢复该纸规原值" Command="{Binding Sheet.ResetSheetCommand}" Margin="6,0,0,0" />
                            </WrapPanel>

                            <TextBlock Text="数值改动后要点「重算整版」才生效（避免边打字边重算）；下拉与纸规选择是立即生效。"
                                       Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />

                            <Border BorderBrush="#D8DDE3" BorderThickness="1" Background="White" MaxHeight="110" Margin="0,6,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Sheet.SheetIssues}" Margin="4,2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <Separator Margin="0,10" />

                            <TextBlock Text="件号 No.x / y 规则" FontWeight="Bold" Margin="0,0,0,4" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="怎么编：" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Sheet.ModeOptions}"
                                          SelectedItem="{Binding Sheet.SelectedMode}"
                                          DisplayMemberPath="Label" />
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="按哪一列数张数：" VerticalAlignment="Center" IsEnabled="{Binding Sheet.IsExpandMode}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Sheet.ExpandColumnOptions}"
                                          SelectedItem="{Binding Sheet.SelectedExpandColumn}"
                                          DisplayMemberPath="Label"
                                          IsEnabled="{Binding Sheet.IsExpandMode}"
                                          ToolTip="用户口径：「张数一般表格里会有一列写的（例：表格写打印 5 张，那对应的那张就要排出 5 张整张纸）」。&#10;选这一档时，每行按那一列的数字展开成几张，一张就是一页纸（开着「一页只排同一枚」时页内铺满全同份数）。&#10;只有「按每行的张数展开」这一档才用得上；读不到数的行会逐行报警，不会静默按 1 张处理。" />
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="口径：" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Sheet.ScopeOptions}"
                                          SelectedItem="{Binding Sheet.SelectedScope}"
                                          DisplayMemberPath="Label" />
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="分组：" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Sheet.GroupOptions}"
                                          SelectedItem="{Binding Sheet.SelectedGroup}"
                                          DisplayMemberPath="Label" />
                            </Grid>

                            <UniformGrid Columns="4" Margin="0,4,0,0">
                                <TextBlock Text="起始号" Style="{StaticResource Hint}" />
                                <TextBox Text="{Binding Sheet.Start, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="步长" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Sheet.Step, UpdateSourceTrigger=PropertyChanged}" />
                            </UniformGrid>

                            <UniformGrid Columns="4" Margin="0,4,0,0">
                                <TextBlock Text="补零位数" Style="{StaticResource Hint}" />
                                <TextBox Text="{Binding Sheet.PadDigits, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="填 3 则 7 号印成 007；填 0 不补零" />
                                <TextBlock Text="每张份数" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Sheet.Copies, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="一箱左右各贴一张就填 2（件号仍只占一个号，总件数不变）" />
                            </UniformGrid>

                            <UniformGrid Columns="4" Margin="0,4,0,0">
                                <TextBlock Text="前缀" Style="{StaticResource Hint}" />
                                <TextBox Text="{Binding Sheet.Prefix, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="后缀" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Sheet.Suffix, UpdateSourceTrigger=PropertyChanged}" />
                            </UniformGrid>

                            <Border BorderBrush="#D8DDE3" BorderThickness="1" Background="White" MaxHeight="110" Margin="0,6,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Sheet.NumberingIssues}" Margin="4,2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                    </StackPanel>

                    <!-- ===== 第 5 步：核对与输出（告警归到这一步，它是印前最后一道闸）===== -->
                    <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource StepEq}, ConverterParameter=4}">
                    <GroupBox>
                        <GroupBox.Header>
                            <TextBlock Text="数据核对与告警" Style="{StaticResource StepTitle}" />
                        </GroupBox.Header>
                        <StackPanel>
                            <Border BorderBrush="#D8DDE3" BorderThickness="1" Background="White" Height="120">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding IssueLines}" Margin="4,2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11.5" Foreground="#B25A00"
                                                           TextWrapping="Wrap" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <TextBlock Text="没有告警表示这批数据的数字类字段都通过了量纲校验。"
                                       Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox>
                        <GroupBox.Header>
                            <TextBlock Text="输出与打印" Style="{StaticResource StepTitle}" />
                        </GroupBox.Header>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="打印机：" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Export.Printers}"
                                          SelectedItem="{Binding Export.SelectedPrinter}"
                                          DisplayMemberPath="DisplayName" />
                                <Button Grid.Column="2" Content="刷新" Command="{Binding Export.RefreshPrintersCommand}" Margin="6,0,0,0" />
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="页范围：" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Export.PageRangeText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="例：1-3,5,7-9；空着表示全部打" />
                                <TextBlock Grid.Column="2" Text="份数：" VerticalAlignment="Center" Margin="8,0,2,0" />
                                <TextBox Grid.Column="3" Text="{Binding Export.Copies, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="逐份重复出纸（先完整打一遍再重复）" />
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="出图精度：" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Export.DpiOptions}"
                                          SelectedItem="{Binding Export.SelectedDpi}" DisplayMemberPath="Label" />
                                <TextBlock Grid.Column="2" Text="PDF 页图：" VerticalAlignment="Center" Margin="8,0,2,0" />
                                <ComboBox Grid.Column="3" ItemsSource="{Binding Export.PdfFormatOptions}"
                                          SelectedItem="{Binding Export.SelectedPdfFormat}" DisplayMemberPath="Label" />
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="输出目录：" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Export.OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="PNG 会在这下面按批名建一个子目录" />
                                <Button Grid.Column="2" Content="选目录…" Command="{Binding Export.ChooseFolderCommand}" Margin="6,0,0,0" />
                            </Grid>

                            <WrapPanel Margin="0,6,0,0">
                                <CheckBox Content="含裁切线/套准标记" IsChecked="{Binding Export.IncludeTrimMarks}" VerticalAlignment="Center" />
                                <CheckBox Content="放不下就缩放" IsChecked="{Binding Export.ScaleToFitPrintableArea}" Margin="12,0,0,0" VerticalAlignment="Center"
                                          ToolTip="默认不勾：缩小后标签就不是原定尺寸了" />
                                <CheckBox Content="打印前看驱动窗口" IsChecked="{Binding Export.ConfirmBeforePrint}" Margin="12,0,0,0" VerticalAlignment="Center"
                                          ToolTip="勾了就能选纸盒/单面双面，但不算静默批量" />
                            </WrapPanel>

                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="唛头文字：" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding TextCaseOptions}" SelectedItem="{Binding SelectedTextCase}"
                                          DisplayMemberPath="Label" MinWidth="118" Margin="4,0,0,0" VerticalAlignment="Center"
                                          ToolTip="三档：按表格里的（默认，原样印）/ 全部大写 / 全部小写。&#10;只改印出来的字：不改你表里的数据，也不改模板存的内容；预览与打印/PDF/图片/SVG 同一口径，不会预览一个样、纸上另一个样。&#10;注意它连你写的固定标签一起转（“Item no：”会变“ITEM NO：”），这是故意的：唛头样张上标签通常也是全大写。" />
                                <TextBlock Text="（表里货号是小写、样张要大写时用这里，不要回去改表）" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </WrapPanel>

                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="SVG 成件：" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Export.SvgModeOptions}"
                                          SelectedItem="{Binding Export.SelectedSvgMode}"
                                          DisplayMemberPath="Label" MinWidth="176" Margin="4,0,0,0"
                                          ToolTip="整页一图：拿回去就能出片；一枚一图：给对方在 CorelDRAW 里自己拼大版" />
                                <CheckBox Content="文字转曲" IsChecked="{Binding Export.SvgTextAsOutlines}" Margin="12,0,0,0" VerticalAlignment="Center"
                                          ToolTip="勾了：字变成轮廓，对方缺中文字体也不掉字，所见即所得（但不能在 CDR 里改字）" />
                                <CheckBox Content="图片内嵌" IsChecked="{Binding Export.SvgEmbedImages}" Margin="12,0,0,0" VerticalAlignment="Center"
                                          ToolTip="勾了：图以 base64 写在 SVG 里，单文件拷走不丢图；不勾则写文件引用" />
                                <CheckBox Content="带注记层" IsChecked="{Binding Export.SvgIncludeNotes}" Margin="12,0,0,0" VerticalAlignment="Center"
                                          ToolTip="多一层元素参考框与字段名，在 CDR 里可整层删，校版时用" />
                            </WrapPanel>

                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="打印整版" Command="{Binding Export.PrintCommand}" FontWeight="Bold" />
                                <Button Content="导出 PDF…" Command="{Binding Export.ExportPdfCommand}" Margin="6,0,0,0" />
                                <Button Content="导出 PNG" Command="{Binding Export.ExportPngCommand}" Margin="6,0,0,0" />
                                <Button Content="导出 TIFF" Command="{Binding Export.ExportTiffCommand}" Margin="6,0,0,0" />
                                <Button Content="导出 SVG…" Command="{Binding Export.ExportSvgCommand}" Margin="6,0,0,0"
                                        ToolTip="衔接店里的 CorelDRAW 出片流程：1 用户单位 = 1 毫米" />
                                <Button Content="取消当前任务" Command="{Binding Export.CancelCommand}" Margin="6,0,0,0" />
                            </WrapPanel>

                            <TextBlock Text="{Binding Export.SelectionText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding Export.FitText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Export.StatusText}" Foreground="#1B5E20" TextWrapping="Wrap" Margin="0,4,0,0" />

                            <TextBlock Text="打印尺寸按毫米 1:1 交给驱动，导出与预览共用同一套画法；如果驱动里开了“适应页面”，打出来就会变小，请先关掉该选项。"
                                       Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </GroupBox>
                    </StackPanel>

                  </StackPanel>
                </ScrollViewer>

                <!-- 底栏：顶上的步骤条管“跳到哪”，这块管“接着往下走”，都不跟着内容滚。 -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="← 上一步" Command="{Binding PrevStepCommand}" MinWidth="86" />
                    <TextBlock Grid.Column="1" Text="{Binding StepHint}" Style="{StaticResource Hint}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Content="下一步 →" Command="{Binding NextStepCommand}" MinWidth="86"
                            Margin="0" FontWeight="Bold" />
                </Grid>
            </Grid>

            <!-- ==================== 右侧：上=预览（单标签 / 整版），下=AI 助手（只有 AI 能拆走） ==================== -->
            <!-- AI 从菜单里搬到这里（第 11 棒）：用户原话「不应该藏起来，应该显示出来」。 -->
            <!-- 第 16 棒改第二版：用户要的是「把 AI 窗口拆下来，和排版拿来对照」——只拆 AI 那一块，预览留在主窗。 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="6" />
                    <RowDefinition x:Name="AiRow" Height="420" MinHeight="260" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0">
                    <GroupBox.Header>
                        <TextBlock Text="预览（按真实毫米尺寸绘制）" Style="{StaticResource StepTitle}" />
                    </GroupBox.Header>

                <TabControl x:Name="RightTabs">
                    <TabItem Header="单标签">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center">
                                <Button Content="⏮ 首件" Command="{Binding FirstRecordCommand}" />
                                <Button Content="◀ 上一件" Command="{Binding PrevRecordCommand}" />
                                <TextBlock Text="{Binding RecordInfoText}" MinWidth="190" VerticalAlignment="Center"
                                           Margin="2,0,10,0" FontWeight="Bold" />
                                <Button Content="下一件 ▶" Command="{Binding NextRecordCommand}" />
                                <Button Content="末件 ⏭" Command="{Binding LastRecordCommand}" />
                                <Button Content="示意预览" Command="{Binding SamplePreviewCommand}" ToolTip="用内置样例数据看版式效果" />
                                <Separator Width="14" Background="Transparent" />
                                <Button Content="－" Command="{Binding ZoomOutCommand}" MinWidth="34" />
                                <Button Content="＋" Command="{Binding ZoomInCommand}" MinWidth="34" />
                                <Button Content="适应窗口" Click="OnFitClick" Margin="6,0,10,0" />
                                <CheckBox x:Name="AutoFitBox" Content="自动适应" IsChecked="True" VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                <CheckBox x:Name="GuideBox" Content="显示要素边框" IsChecked="{Binding ShowGuides}"
                                          VerticalAlignment="Center" />
                            </WrapPanel>

                            <Border Grid.Row="1" x:Name="PreviewHost" Background="#E7EAEE"
                                    BorderBrush="#CDD3DA" BorderThickness="1"
                                    SizeChanged="OnPreviewHostSizeChanged">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              Background="Transparent" Padding="12">
                                    <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <render:LabelPreviewControl Layout="{Binding CurrentLayout}"
                                                                    Zoom="{Binding Zoom}"
                                                                    ShowGuides="{Binding ShowGuides}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center" />
                                    </ContentControl>
                                </ScrollViewer>
                            </Border>

                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock Text="{Binding TokenNoteText}" Style="{StaticResource Hint}"
                                           Foreground="#B25A00" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Text="说明：此处已是编号后的单张标签（一行多箱时会展开成多张）；预览按毫米真实尺寸绘制，打印/PDF（M3）复用同一份版面数据。" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="整版拼版">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center">
                                <Button Content="⏮ 首页" Command="{Binding Sheet.FirstPageCommand}" />
                                <Button Content="◀ 上一页" Command="{Binding Sheet.PrevPageCommand}" />
                                <TextBlock Text="{Binding Sheet.PageText}" MinWidth="190" VerticalAlignment="Center"
                                           Margin="2,0,10,0" FontWeight="Bold" />
                                <Button Content="下一页 ▶" Command="{Binding Sheet.NextPageCommand}" />
                                <Button Content="末页 ⏭" Command="{Binding Sheet.LastPageCommand}" />
                                <Separator Width="14" Background="Transparent" />
                                <Button Content="－" Command="{Binding SheetZoomOutCommand}" MinWidth="34" />
                                <Button Content="＋" Command="{Binding SheetZoomInCommand}" MinWidth="34" />
                                <Button Content="适应窗口" Click="OnSheetFitClick" Margin="6,0,10,0" />
                                <CheckBox Content="自动适应" x:Name="SheetAutoFitBox" IsChecked="True"
                                          VerticalAlignment="Center" Margin="0,0,10,0" />
                                <CheckBox Content="显示要素边框" IsChecked="{Binding ShowGuides}" VerticalAlignment="Center" />
                            </WrapPanel>

                            <Border Grid.Row="1" x:Name="SheetHost" Background="#E7EAEE"
                                    BorderBrush="#CDD3DA" BorderThickness="1"
                                    SizeChanged="OnSheetHostSizeChanged">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              Background="Transparent" Padding="12">
                                    <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <render:SheetPreviewControl x:Name="SheetView"
                                                                    Plan="{Binding Sheet.Plan}"
                                                                    PageIndex="{Binding Sheet.PageIndex}"
                                                                    Zoom="{Binding Sheet.SheetZoom}"
                                                                    ShowGuides="{Binding ShowGuides}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center" />
                                    </ContentControl>
                                </ScrollViewer>
                            </Border>

                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Sheet.PlanText}" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Text="灰色虚线框 = 页边可用区；细虚线 = 裁切角线；蓝色虚线十字 = 套准标记。预览里这三样一律画成虚线，提醒它们本是给眼睛看的位置示意（打印店那张纸上通常不需要这些线）；要不要真上纸，由纸规的「裁切线」和 ⑤ 步的「含裁切线/套准标记」说了算，导出与打印按同一份几何走（Core 的 ImpositionEngine）。" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                </TabControl>
                </GroupBox>

                <!-- 预览与 AI 之间可拖：AI 那块想高一点就往下拽这条 -->
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                              Background="#EDF0F4" ResizeBehavior="PreviousAndNext" />

                <GroupBox Grid.Row="2" x:Name="AiBox">
                    <GroupBox.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="AI 助手" Style="{StaticResource StepTitle}" />
                            <Button Grid.Column="1" x:Name="DetachAiButton" Content="把 AI 拆成独立窗口 ⇱"
                                    Click="OnDetachAiClick" Padding="9,1" MinWidth="152"
                                    ToolTip="只把 AI 这一块拆成独立窗口：AI 在窗外、排版在窗内，摆在一起对照着改；再点一下收回原位" />
                        </Grid>
                    </GroupBox.Header>
                    <!-- AI 面板由代码建好放进这个宿主（同一个实例在宿主与浮动窗之间搬，不复制第二套面板） -->
                    <ContentControl x:Name="AiHost" />
                </GroupBox>

                <!-- 拆出去之后原位不能空成一块白板让人以为程序炸了：说实话 + 给一个收回入口 -->
                <Border Grid.Row="2" x:Name="DetachedHint" Visibility="Collapsed"
                        Background="#F5F7FA" BorderBrush="#CDD3DA" BorderThickness="1" Padding="10,8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AI 助手已拆成独立窗口（标题「LabelGou · AI 助手」），这一行的高度还给预览。&#10;把那个窗口拖到显示器另一边，就能 AI 在窗外、排版在窗内对照着看；关掉它也会自动收回这里。"
                                   Style="{StaticResource Hint}" TextWrapping="Wrap" />
                        <Button Content="收回这里" Click="OnDetachAiClick" Margin="0,8,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
