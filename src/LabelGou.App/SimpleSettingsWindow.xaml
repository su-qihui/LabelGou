<Window x:Class="LabelGou.App.SimpleSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:render="clr-namespace:LabelGou.App.Rendering"
        Title="设置 · LabelGou 简洁版"
        Width="780" Height="540" MinWidth="640" MinHeight="440"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei" FontSize="14"
        Background="{DynamicResource PageBgBrush}">
    <!-- 简洁版的设置页（第 102 棒，用户：「对新界面部分未加入的小调优方到设置并添加预览效果」
         +「设置页面加入一个模板 而不是实际预览」）。
         右边那张纸是**示意模板**（首页海报墙同一个入口排出来的），不是他手上的真数据——
         不用先导表就能调；改左边一个数，那张纸当场跟着变，这才是"预览效果"的意思。 -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SimpleTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,12">
            <TextBlock Text="设置" Style="{StaticResource ScreenTitle}"/>
            <TextBlock Style="{StaticResource SubText}" Text="这几颗原来写死在代码里，只能改程序才能调；现在放到这里，改完点「好」就记住。"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：三档。数值与拖拽并存（他定过的规矩：能拖的也要能直接输数字） -->
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="纸张留白" FontWeight="Bold"/>
                        <TextBlock Style="{StaticResource SubText}" Margin="0,2,0,8"
                                   Text="中间那格自动把纸显示全之外，再留一圈边。数字越大纸越小、台面看得越多。"/>
                        <DockPanel>
                            <TextBox x:Name="PaperMarginBox" DockPanel.Dock="Right" Width="56" Margin="10,0,0,0"
                                     TextAlignment="Center" LostFocus="OnPaperMarginBoxLostFocus"/>
                            <Slider x:Name="PaperMarginSlider" VerticalAlignment="Center"
                                    Minimum="24" Maximum="120" IsSnapToTickEnabled="True" TickFrequency="2"
                                    ValueChanged="OnPaperMarginSliderChanged"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="海报墙卡片宽" FontWeight="Bold"/>
                        <TextBlock Style="{StaticResource SubText}" Margin="0,2,0,8"
                                   Text="首页那圈模板卡一张多宽。窄窗口想多排几列就调小，想看清版式就调大。"/>
                        <DockPanel>
                            <TextBox x:Name="PosterWidthBox" DockPanel.Dock="Right" Width="56" Margin="10,0,0,0"
                                     TextAlignment="Center" LostFocus="OnPosterWidthBoxLostFocus"/>
                            <Slider x:Name="PosterWidthSlider" VerticalAlignment="Center"
                                    Minimum="180" Maximum="320" IsSnapToTickEnabled="True" TickFrequency="4"
                                    ValueChanged="OnPosterWidthSliderChanged"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="外观" FontWeight="Bold"/>
                        <CheckBox x:Name="DarkCheck" Content="深色模式" Margin="0,6,0,0"
                                  Checked="OnDarkChanged" Unchecked="OnDarkChanged"
                                  ToolTip="与顶栏那颗太阳/月亮是同一件事；这里只改这一页的预览，整窗要回壳窗点那颗"/>
                        <DockPanel Margin="0,10,0,0">
                            <Button x:Name="PromptBtn" Content="AI 提示语…" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                    Click="OnOpenPromptsClick"
                                    ToolTip="发给 AI 的那几段话，打开来看、也可以自己改（第 103 棒）。改完立刻生效；随时能一键回出厂。"/>
                            <TextBlock x:Name="PromptStateText" Style="{StaticResource SubText}" VerticalAlignment="Center"
                                       Text="发给 AI 的话可以改"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 右：示意模板。留白就是这块"台面"的内边距——纸在里面上色、缩放，看得见的就是那圈边 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubText}" Margin="2,0,0,8"
                               Text="示意模板（跟首页海报墙同一张纸，不是你的真数据）"/>
                    <Border x:Name="PreviewStage" Background="{DynamicResource PageBgBrush}" CornerRadius="8"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="56">
                        <Viewbox Stretch="Uniform">
                            <Border Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                <render:LabelPreviewControl x:Name="PreviewView" Zoom="1" ShowGuides="False"/>
                            </Border>
                        </Viewbox>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="2,14,0,0">
            <Button x:Name="OkBtn" Content="好" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnOkClick"/>
            <Button Content="取消" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="OnCancelClick"/>
            <Button Content="恢复默认" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Click="OnResetClick"/>
            <TextBlock Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="12,0"
                       Text="「恢复默认」只是把这一页的数拨回出厂那档，点「好」才算记住。"/>
        </DockPanel>
    </Grid>
</Window>
